static uint64_t harc_rng_state = 0;
static inline uint64_t harc_rng_next() {
    uint64_t z = (harc_rng_state += 0x9E3779B97F4A7C15ULL);
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
    return z ^ (z >> 31);
}
static inline int64_t harc_rng_range(int64_t lo, int64_t hi) {
    if (hi <= lo) return lo;
    return lo + (int64_t)(harc_rng_next() % (uint64_t)(hi - lo + 1));
}
static inline uint64_t harc_rng_uint(unsigned width) {
    if (width >= 64) return harc_rng_next();
    return harc_rng_next() & ((1ULL << width) - 1);
}
static inline int64_t harc_rng_dist(const std::vector<std::tuple<int64_t,int64_t,int64_t>>& bins) {
    int64_t total = 0; for (auto& b : bins) total += std::get<2>(b);
    if (total <= 0) return 0;
    int64_t pick = (int64_t)(harc_rng_next() % (uint64_t)total);
    int64_t acc = 0;
    for (auto& b : bins) { acc += std::get<2>(b); if (pick < acc) return harc_rng_range(std::get<0>(b), std::get<1>(b)); }
    return std::get<0>(bins.front());
}

int main(int argc, char** argv) {
    Verilated::commandArgs(argc, argv);
    VWrapCounter* dut = new VWrapCounter;
    int errors = 0;
    int cycle_count = 0;

    { const char* s = std::getenv("HARC_SEED"); harc_rng_state = s ? std::strtoull(s, nullptr, 0) : 1ULL; }

    const char* sim_log_path = std::getenv("HARC_SIM_LOG");
    if (!sim_log_path) sim_log_path = "sim.log";
    FILE* sim_log = std::fopen(sim_log_path, "w");

    std::vector<std::function<void()>> _checkers;

    auto tick = [&]() {
        dut->clk = 0; dut->eval();
        dut->clk = 1; dut->eval();
        cycle_count++;
        for (auto& _c : _checkers) _c();
    };

    std::unordered_map<std::string, FILE*> log_files;
    auto resolve_log_path = [&](const char* path) -> std::string {
        if (path[0] == '/') return std::string(path);
        const char* base = std::getenv("HARC_LOG_DIR");
        if (base) return std::string(base) + "/" + path;
        return std::string(path);
    };
    auto get_log_file = [&](const char* path) -> FILE* {
        std::string resolved = resolve_log_path(path);
        auto it = log_files.find(resolved);
        if (it != log_files.end()) return it->second;
        FILE* f = std::fopen(resolved.c_str(), "w");
        log_files[resolved] = f;
        return f;
    };

    auto sim_logf_line = [&](FILE* f, const char* sev, const char* fmt, ...) {
        va_list ap;
        std::printf("[cycle:%d %s] ", cycle_count, sev);
        va_start(ap, fmt); std::vprintf(fmt, ap); va_end(ap);
        std::printf("\n");
        if (f) {
            std::fprintf(f, "[cycle:%d %s] ", cycle_count, sev);
            va_start(ap, fmt); std::vfprintf(f, fmt, ap); va_end(ap);
            std::fprintf(f, "\n");
            std::fflush(f);
        }
    };

    auto sim_log_line = [&](const char* sev, const char* fmt, ...) {
        va_list ap;
        std::printf("[cycle:%d %s] ", cycle_count, sev);
        va_start(ap, fmt); std::vprintf(fmt, ap); va_end(ap);
        std::printf("\n");
        if (sim_log) {
            std::fprintf(sim_log, "[cycle:%d %s] ", cycle_count, sev);
            va_start(ap, fmt); std::vfprintf(sim_log, fmt, ap); va_end(ap);
            std::fprintf(sim_log, "\n");
            std::fflush(sim_log);
        }
    };

    sim_log_line("INFO", "seed=%llu", (long long)harc_rng_state);

    harc_rt::ThreadScheduler sched;
    harc_rt::ThreadSlot _run_slot;
    sched.slots.push_back(&_run_slot);
    _run_slot.thread = [&](harc_rt::ThreadSlot* _slot) -> harc_rt::HarcThread {
        dut->rst = 1;
        dut->inc = 0;
        dut->max = 15;
        co_await harc_rt::wait_cycles(_slot, (uint32_t)(2));
        dut->rst = 0;
        for (int64_t i = 0; i < 16; i++) {
            if (!(dut->value == i)) {
                sim_log_line("FAIL", "count mismatch");
                errors++;
            }
            if (i == 15) {
                if (!(dut->at_max)) {
                    sim_log_line("FAIL", "at_max should be 1 at 15");
                    errors++;
                }
            }
            dut->inc = 1;
            co_await harc_rt::wait_cycles(_slot, (uint32_t)(1));
        }
        if (!(dut->value == 0)) {
            sim_log_line("FAIL", "wrap failed");
            errors++;
        }
        sim_log_line("INFO", "PASS: wrap at MAX=15");
        dut->inc = 0;
        co_await harc_rt::wait_cycles(_slot, (uint32_t)(2));
        if (!(dut->value == 0)) {
            sim_log_line("FAIL", "hold failed");
            errors++;
        }
        sim_log_line("INFO", "PASS: hold when inc=0");
        co_return;
    }(&_run_slot);

    // Resume each coroutine once so initial-setup statements run
    // before the first clock edge. Single-threaded — workers
    // haven't been spawned yet.
    sched.bootstrap();

    // Drive the clock until the run coroutine completes.
    while (_run_slot.kind != harc_rt::WaitKind::Done) {
        sched.tick();
        dut->clk = 0; dut->eval();
        dut->clk = 1; dut->eval();
        cycle_count++;
        for (auto& _c : _checkers) _c();
    }


    dut->final();
    delete dut;
    if (sim_log) std::fclose(sim_log);
    for (auto& kv : log_files) { if (kv.second) std::fclose(kv.second); }

    if (errors == 0) { std::printf("\nALL TESTS PASSED\n"); return 0; }
    else             { std::printf("\n%d TESTS FAILED\n", errors); return 1; }
}
