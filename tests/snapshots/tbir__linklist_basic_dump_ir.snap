    Assign(%d_2, (%__t27 ? %__t28 : 57005))
    -> WaitCyclesSync(1, b42)

  b42:
    Assign(%__t26, %d_2)
    -> Jump(b39)

  b43:
    AssertCheck { cond: (%__t29 == 20), on_fail: "FIFO[1]" }
    Assign(%__t32, 0)
    DutWrite(dut.delete_head_req_valid, 1)
    -> WaitCyclesSync(1, b48)

  b44:
    DutWrite(dut.delete_head_req_valid, 0)
