    AssertCheck { cond: (dut.length == 1), on_fail: "length=%lld after alloc, expected 1", dut.length }
    AssertCheck { cond: (dut.empty == 0), on_fail: "empty after alloc" }
    Assign(%__t5, 0)
    Assign(%handle, %h_2)
    DutWrite(dut.free_req_valid, 1)
    DutWrite(dut.free_req_handle, %handle)
    -> WaitCyclesSync(1, b9)

