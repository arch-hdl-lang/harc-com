    DutRead(%__t40, dut.insert_tail_resp_valid)
    DutRead(%__t41, dut.insert_tail_resp_handle)
    Assign(%h_8, (%__t40 ? %__t41 : 255))
    -> WaitCyclesSync(1, b64)

