  b51:
    AssertCheck { cond: (%__t35 == 40), on_fail: "FIFO[3]" }
    AssertCheck { cond: (dut.empty == 1), on_fail: "empty after 4-drain" }
    Log(info, "PASS: FIFO order across 4 inserts")
    Assign(%__t38, 0)
    DutWrite(dut.rst, 1)
    DutWrite(dut.alloc_req_valid, 0)
    DutWrite(dut.free_req_valid, 0)
    DutWrite(dut.free_req_handle, 0)
    DutWrite(dut.insert_tail_req_valid, 0)
    DutWrite(dut.insert_tail_req_data, 0)
    DutWrite(dut.delete_head_req_valid, 0)
    DutWrite(dut.read_data_req_valid, 0)
    DutWrite(dut.read_data_req_handle, 0)
    DutWrite(dut.write_data_req_valid, 0)
    DutWrite(dut.write_data_req_handle, 0)
    DutWrite(dut.write_data_req_data, 0)
    -> WaitCyclesSync(2, b56)

  b52:
    DutWrite(dut.delete_head_req_valid, 0)
    -> WaitCyclesSync(1, b53)

  b53:
    DutRead(%__t36, dut.delete_head_resp_valid)
    DutRead(%__t37, dut.delete_head_resp_data)
    Assign(%d_5, (%__t36 ? %__t37 : 57005))
    -> WaitCyclesSync(1, b54)

  b54:
    Assign(%__t35, %d_5)
    -> Jump(b51)

  b55:
    Assign(%i, 0)
    -> Jump(b57)

  b56:
    DutWrite(dut.rst, 0)
    -> Jump(b55)

  b57:
    -> Branch((%i < 8), b58, b60)

  b58:
    Assign(%__t39, 0)
    Assign(%data_6, (256 + %i))
    DutWrite(dut.insert_tail_req_valid, 1)
    DutWrite(dut.insert_tail_req_data, %data_6)
    -> WaitCyclesSync(1, b62)

  b59:
    Assign(%i, (%i + 1))
    -> Jump(b57)

