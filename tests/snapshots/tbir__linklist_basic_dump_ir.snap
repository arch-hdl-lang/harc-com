  b49:
    DutRead(%__t33, dut.delete_head_resp_valid)
    DutRead(%__t34, dut.delete_head_resp_data)
    Assign(%d_4, (%__t33 ? %__t34 : 57005))
    -> WaitCyclesSync(1, b50)

  b50:
    Assign(%__t32, %d_4)
