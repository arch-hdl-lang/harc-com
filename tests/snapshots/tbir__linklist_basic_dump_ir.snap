    DutRead(%__t18, dut.insert_tail_resp_valid)
    DutRead(%__t19, dut.insert_tail_resp_handle)
    Assign(%h_5, (%__t18 ? %__t19 : 255))
    -> WaitCyclesSync(1, b30)

  b30:
