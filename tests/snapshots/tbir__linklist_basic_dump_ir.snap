    AssertCheck { cond: (dut.full == 1), on_fail: "full after 8 inserts" }
    AssertCheck { cond: (dut.length == 8), on_fail: "length=%lld, expected 8", dut.length }
    AssertCheck { cond: (dut.insert_tail_req_ready == 0), on_fail: "insert_tail_req_ready should be 0 when full" }
    Assign(%i_2, 0)
    -> Jump(b65)

  b61:
    -> Jump(b59)

  b62:
    DutWrite(dut.insert_tail_req_valid, 0)
    DutWrite(dut.insert_tail_req_data, 0)
    -> WaitCyclesSync(1, b63)

