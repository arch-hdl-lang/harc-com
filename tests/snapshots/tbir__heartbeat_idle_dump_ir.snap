---
source: tests/tbir.rs
expression: "format!(\"{prog}\")"
---
tb-ir program
  testbench tb0 HeartbeatIdleTb { dut: Top }
  test HeartbeatIdleTest tb=tb0 run=fn1 check=- clock=clk@10000ps(SysDomain)
  record r0 TinyTxn
    tag : uint<8>
  component c0 Producer (agent)
    field in_ev : out event<TinyTxn>
    field seen : scalar = 0

fn fn0 comp_on_0 [kind=ComponentMethod(c0)]
  params:
    t : record(r0)
  locals:
    %0 t : record(r0)
  entry = b0

  b0:
    ComponentFieldWrite(self.seen, (self.seen + 1))
    -> Return

fn fn1 run_HeartbeatIdleTest [kind=Run, owner=tb0]
  locals:
    %0 i : unknown
    %1 t : record(r0)
    %2 waited : unknown
    %3 budget : unknown
  entry = b0

  b0:
    DutWrite(dut.rst, 1)
    DutWrite(dut.en, 0)
    -> WaitCycles(2, b1)

  b1:
    DutWrite(dut.rst, 0)
    -> WaitCycles(1, b2)

  b2:
    Assign(%i, 0)
    -> Jump(b3)

  b3:
    -> Branch((%i < 3), b4, b6)

  b4:
    RecordInit(%t, r0)
    RecordFieldWrite(%t.tag, %i)
    ComponentEmit(prod.in_ev, [%t])
    -> WaitCycles(3, b7)

  b5:
    Assign(%i, (%i + 1))
    -> Jump(b3)

  b6:
    Assign(%waited, 0)
    Assign(%budget, 100)
    -> Jump(b8)

  b7:
    -> Jump(b5)

  b8:
    -> Branch((!prod.idle_in(8) && (%waited < %budget)), b9, b10)

  b9:
    -> WaitCycles(1, b11)

  b10:
    AssertCheck { cond: prod.idle_in(8), on_fail: "agent did not report idle_in(8) within %lld cycles after last emit; waited=%lld", %budget, %waited }
    AssertCheck { cond: (prod.seen == 3), on_fail: "expected 3 emits to register, got %lld", prod.seen }
    Log(info, "PASS: agent reported idle_in(8) after %lld cycles of inactivity; seen=%lld", %waited, prod.seen)
    -> Return

  b11:
    Assign(%waited, (%waited + 1))
    -> Jump(b8)
