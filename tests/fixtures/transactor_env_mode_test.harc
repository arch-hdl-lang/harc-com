// Spec §8 mode inheritance through TWO composition levels:
//
//   env  E  passive  →  agent A inherits passive  →  transactor T inherits passive
//
// The same env declaration is reused at two instantiations:
//
//   let active_env  : E active   →  E.ag is active  →  E.ag.drv is active
//   let passive_env : E passive  →  E.ag is passive →  E.ag.drv is passive
//
// Field-level explicit modes still win at any level; only fields
// without an explicit mode inherit from the parent.
//
// In this fixture the active env drives 5 transactions through its
// agent's sequencer → connect → transactor.req chain. The passive
// env never invokes its sequencer (passive agents have a dormant
// sequencer); its transactor's always-on cycle-trigger handlers
// observe the bus traffic generated by the active env's agent.
// Both envs' transactor scoreboards see 5 writes + 5 reads —
// proving:
//
//   1. Mode flows two levels deep:  env's mode reaches the
//      transactor at the bottom of the composition chain, with no
//      explicit annotation needed at any field site.
//   2. Active body cleanly elides on `passive_env.ag.drv` (the
//      passive agent's sequencer was never dispatched).
//   3. Always-on body fires regardless of effective mode (so a
//      passive env's transactor still observes external traffic).

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
end transaction RegOp

scoreboard ObsSb
    writes : uint<32> default 0
    reads  : uint<32> default 0
end scoreboard ObsSb

sequencer AxilSeq
    dispatched : out event<RegOp>

    hookable dispatch(txns: TSeq<RegOp>)
        for t in txns
            emit dispatched(t)
        end for
    end dispatch
end sequencer AxilSeq

// Transactor with both halves. The always-on body observes every
// AXI handshake on the W and R channels — present on BOTH active
// and passive instances. The `when active` body drives writes and
// reads on `req`.
transactor AxilXactor
    dut : AxiLiteRegs
    sb  : ObsSb
    last_read : uint<32> default 0

    on dut.axil_w_valid && dut.axil_w_ready
        sb.writes = sb.writes + 1
    end on

    on dut.axil_r_valid && dut.axil_r_ready
        sb.reads = sb.reads + 1
    end on

    when active
        req : in event<RegOp>

        on req(t)
            // Write phase
            dut.axil_aw_addr = t.addr
            dut.axil_aw_valid = 1
            dut.axil_w_data = t.value
            dut.axil_w_strb = 15
            dut.axil_w_valid = 1
            wait 10 cycles
            dut.axil_aw_valid = 0
            dut.axil_w_valid = 0
            wait 2 cycles

            // Read phase
            let val = 0
            let saw = 0
            dut.axil_ar_addr = t.addr
            dut.axil_ar_valid = 1
            for _ in 0 .. 10
                wait 1 cycle
                if dut.axil_r_valid
                    if saw == 0
                        val = dut.axil_r_data
                        dut.axil_ar_valid = 0
                        saw = 1
                    end if
                end if
            end for
            dut.axil_ar_valid = 0
            wait 1 cycle
            last_read = val
        end on
    end when
end transactor AxilXactor

// Agent — sequencer + transactor + connect. The transactor field
// `drv : AxilXactor` has no explicit mode: it inherits from this
// agent's instantiation mode, which in turn inherits from the env.
agent AxilAgent
    sequencer : AxilSeq
    drv       : AxilXactor

    connect
        sequencer.dispatched -> drv.req
    end connect
end agent AxilAgent

// Env — `ag : AxilAgent` has no explicit mode either. Mode flows
// from the let-instantiation of E.
env AxilEnv
    ag : AxilAgent
end env AxilEnv

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test TransactorEnvModeTest
    let dut : AxiLiteRegs

    // Same env declaration, two instantiations. Mode flows down two
    // levels (env → agent → transactor) at each.
    let active_env  : AxilEnv active
    let passive_env : AxilEnv passive

    scope sim
        run
            log(info, "env mode inheritance flows env → agent → transactor")

            active_env.ag.drv.dut = dut
            passive_env.ag.drv.dut = dut

            // Reset.
            dut.rst = 1
            dut.axil_aw_addr = 0
            dut.axil_aw_valid = 0
            dut.axil_w_data = 0
            dut.axil_w_strb = 15
            dut.axil_w_valid = 0
            dut.axil_b_ready = 1
            dut.axil_ar_addr = 0
            dut.axil_ar_valid = 0
            dut.axil_r_ready = 1
            dut.mm2s_done = 0
            dut.mm2s_halted = 1
            dut.mm2s_idle = 1
            dut.s2mm_done = 0
            dut.s2mm_halted = 1
            dut.s2mm_idle = 1
            dut.mm2s_sg_done = 0
            dut.s2mm_sg_done = 0
            dut.mm2s_sg_active = 0
            dut.s2mm_sg_active = 0
            wait 2 cycles
            dut.rst = 0
            wait 1 cycle

            // Drive 5 transactions through the ACTIVE env's agent.
            // active_env.ag.sequencer.dispatched (active inherited)
            //   → connect bridge inside the agent
            //   → active_env.ag.drv.req (active inherited)
            //   → on req(t) drives the DUT bus.
            //
            // We never dispatch passive_env.ag.sequencer — the
            // passive env's agent has a dormant sequencer.
            let txns = RandomTxns(5)
            active_env.ag.sequencer.dispatch(txns)

            wait 10 cycles

            // Both transactors' always-on observers fired on every
            // valid+ready handshake. The passive env's transactor
            // observed the active env's traffic without ever
            // generating any.
            assert passive_env.ag.drv.sb.writes == 5
                else fail("passive env: writes=${passive_env.ag.drv.sb.writes}, expected 5")
            assert passive_env.ag.drv.sb.reads == 5
                else fail("passive env: reads=${passive_env.ag.drv.sb.reads}, expected 5")

            assert active_env.ag.drv.sb.writes == 5
                else fail("active env: writes=${active_env.ag.drv.sb.writes}, expected 5")
            assert active_env.ag.drv.sb.reads == 5
                else fail("active env: reads=${active_env.ag.drv.sb.reads}, expected 5")

            log(info, "PASS: same env decl, mode inherited two levels — env→agent→transactor")
        end run
    end scope sim
end test TransactorEnvModeTest
