domain D
    freq_mhz : 100
end domain D

transaction ListPacket
    items : list<uint<8>>
    keep items.len() == 3
    keep for item in items
        item == 2
    end for
end transaction ListPacket

test RecordListRandomizeTest
    let dut : Top
    let packet : ListPacket
    clock clk = D
    run
        randomize(packet)
        assert packet.items.len() == 3
        assert packet.items.size() == 3
        assert !packet.items.empty()
        wait 1 cycle
    end run
end test RecordListRandomizeTest
