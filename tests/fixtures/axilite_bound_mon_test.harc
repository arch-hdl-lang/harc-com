// AxiLiteRegs test exercising the *passive* observation half of a
// transactor. One transactor declares both halves: an active driver
// coroutine (under `when active`) and a passive monitor (always-on
// body with `on bus.<ch>.handshake` handlers that push observed
// payloads into a scoreboard).
//
// Two instances at test scope:
//   - `drv : AxilXactor active`  — fires the driver coroutine on
//     each `emit drv.req(t)`, drives the bus.
//   - `mon : AxilXactor passive` — synthesizes only the always-on
//     body. The handshake handlers run as monitor-actor coroutines
//     that fire once per valid+ready cycle on each channel,
//     concurrently with `drv`.
//
// This replaces the legacy `driver AxilDrv bound to BusAxiLite` +
// `monitor AxilMon bound to BusAxiLite` split with a single
// transactor whose mode is selected at the let site.

use BusAxiLite

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction RegOp

scoreboard AxilSb
    written : queue<uint<32>>     // observed write data on bus.w
    read    : queue<uint<32>>     // observed read data on bus.r
    errors  : uint<32> default 0
end scoreboard AxilSb

transactor AxilXactor bound to BusAxiLite
    sb        : AxilSb
    last_read : uint<32> default 0

    // Always-on observation half — fires for every handshake on
    // both `active` and `passive` instances. Pushes payloads into
    // the per-instance `sb` field.
    on bus.w.handshake(d)
        sb.written.push(d)
    end on

    on bus.r.handshake(d)
        sb.read.push(d)
    end on

    when active
        req : in event<RegOp>

        on req(t)
            bus.aw.addr = t.addr
            bus.aw.valid = 1
            bus.w.send(t.value, 15)
            bus.aw.valid = 0
            wait 2 cycles
            bus.ar.addr = t.addr
            bus.ar.valid = 1
            let val = bus.r.recv()
            bus.ar.valid = 0
            wait 1 cycle
            last_read = val
        end on
    end when
end transactor AxilXactor

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test AxiLiteBoundMonTest
    let dut  : AxiLiteRegs
    let axil : BusAxiLite = bind dut
    let drv  : AxilXactor active  = bind axil
    let mon  : AxilXactor passive = bind axil
end test AxiLiteBoundMonTest

impl sim for AxiLiteBoundMonTest
    run
        log(info, "AxiLiteRegs transactor passive-observer test")

        // Reset.
        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Dispatch 5 transactions through the active transactor.
        let txns = RandomTxns(5)
        for t in txns
            emit drv.req(t)
        end for

        // Wait for the driver to drain. Each round-trip ~7 cycles.
        wait 60 cycles

        // The passive instance pushed 5 observed write payloads
        // and 5 observed read payloads into mon.sb. The active
        // instance also has its own observation half firing into
        // drv.sb, but the test only checks mon for clarity.
        assert mon.sb.written.size() == 5
            else fail("expected 5 writes observed, got ${mon.sb.written.size()}")
        assert mon.sb.read.size() == 5
            else fail("expected 5 reads observed, got ${mon.sb.read.size()}")

        log(info, "PASS: passive transactor observed 5 writes + 5 reads")
    end run
end impl AxiLiteBoundMonTest

