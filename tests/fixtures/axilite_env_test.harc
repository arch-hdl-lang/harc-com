// AxiLiteRegs test using `env` to compose a transactor (helper-method
// flavor) and a `scoreboard` into a single named environment.
// Demonstrates the composite-component shape end-to-end:
//
//   env E
//       drv : Drv passive
//       sb  : S
//   end env E
//
// lowers to `struct E { Drv drv; S sb; };`. Method calls compose:
// `env.drv.axil_write(args)` rewrites to `Drv_axil_write(env.drv, args)`.
// The scoreboard's `expected.push(...)` works through ordinary struct
// field access.
//
// The transactor here uses only the always-on body — no `when active`
// half — because the methods are called directly from the test scope
// (no event-driven dispatch). Mode `passive` at the field site
// suppresses the active-half codegen, matching the methods-only
// shape.

transaction AxilTxn
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction AxilTxn

transactor AxilXactor
    dut : AxiLiteRegs

    when active
        hookable axil_write(addr: uint<8>, data: uint<32>)
            dut.axil_aw_addr = addr
            dut.axil_aw_valid = 1
            dut.axil_w_data = data
            dut.axil_w_strb = 15
            dut.axil_w_valid = 1
            wait 10 cycles
            dut.axil_aw_valid = 0
            dut.axil_w_valid = 0
            wait 2 cycles
        end axil_write

        hookable axil_read(addr: uint<8>) -> uint<32>
            let val = 0
            let saw = 0
            dut.axil_ar_addr = addr
            dut.axil_ar_valid = 1
            for _ in 0 .. 9
                wait 1 cycle
                if dut.axil_r_valid
                    if saw == 0
                        val = dut.axil_r_data
                        dut.axil_ar_valid = 0
                        saw = 1
                    end if
                end if
            end for
            dut.axil_ar_valid = 0
            wait 1 cycle
            return val
        end axil_read
    end when
end transactor AxilXactor

scoreboard AxilSb
    expected : queue<uint<32>>
    errors   : uint<32> default 0
end scoreboard AxilSb

env AxilEnv
    drv : AxilXactor active
    sb  : AxilSb
end env AxilEnv

tseq RandomTxns(n: int) -> TSeq<AxilTxn>
    for _ in 1 .. n
        let t : AxilTxn
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

testbench AxiLiteEnvTb
    dut : AxiLiteRegs
    env : AxilEnv
end testbench AxiLiteEnvTb

impl AxiLiteEnvTest for AxiLiteEnvTb
    run
        log(info, "AxiLiteRegs env-composite test")
        env.drv.dut = dut

        // Reset.
        dut.rst = 1
        dut.axil_aw_addr = 0
        dut.axil_aw_valid = 0
        dut.axil_w_data = 0
        dut.axil_w_strb = 15
        dut.axil_w_valid = 0
        dut.axil_b_ready = 1
        dut.axil_ar_addr = 0
        dut.axil_ar_valid = 0
        dut.axil_r_ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        let txns = RandomTxns(5)
        for t in txns
            env.sb.expected.push(t.value)
            env.drv.axil_write(t.addr, t.value)
            let got = env.drv.axil_read(t.addr)
            let exp = env.sb.expected.pop()
            if got != exp
                env.sb.errors = env.sb.errors + 1
            end if
        end for
        assert env.sb.errors == 0
            else fail("env.sb.errors = ${env.sb.errors}")

        log(info, "PASS: 5 round-trips through env.drv with env.sb scoreboard")
    end run
end impl AxiLiteEnvTest

