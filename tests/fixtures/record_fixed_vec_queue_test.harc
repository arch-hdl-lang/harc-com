// Fixed record-vector queue storage and read-only queries must compile and run
// under TBIR. v1 silently substitutes uint64_t for the record leaf (and drops
// nested dimensions); the empty query trace remains a retirement-era gate.

transaction Beat
    data : uint<8>
end transaction Beat

testbench RecordFixedVecQueueTb
    dut : Top
    values : queue<Vec<Beat, 4>>
end testbench RecordFixedVecQueueTb

impl RecordFixedVecQueueTest for RecordFixedVecQueueTb
    run
        assert values.empty()
        assert values.size() == 0
        wait 1 cycle
    end run
end impl RecordFixedVecQueueTest
