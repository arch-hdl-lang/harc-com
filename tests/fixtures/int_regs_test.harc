// HARC TB for arch-com/examples/int_regs.arch — 32×8b register file
// with 2 read ports + 1 write port and write-before-read forwarding.
// Mirrors arch-com/examples/regfile_tb.cpp.
//
// NOTE on addr 0: the underlying SV gates writes with `write_addr != 0`
// (RISC-V x0 hardwire). So we write/read addrs 1..7 and separately
// confirm reg[0] stays zero through write attempts.

function write_reg(dut: IntRegs, addr: uint<5>, data: uint<8>)
    dut.write_en = 1
    dut.write_addr = addr
    dut.write_data = data
    wait 1 cycle
end function write_reg

test IntRegsTest
    let dut : IntRegs

    scope sim
        run
            // Reset
            dut.rst = 1
            dut.write_en = 0
            dut.write_addr = 0
            dut.write_data = 0
            dut.read0_addr = 0
            dut.read1_addr = 0
            wait 2 cycles
            dut.rst = 0

            // Write registers 1..7 with pattern (i * 11 + 5) & 0xFF.
            // Skip addr 0 — the regfile hardwires it to zero.
            for i in 1 .. 8
                write_reg(dut, i, (i * 11 + 5) & 255)
            end for
            dut.write_en = 0
            wait 1 cycle

            // Read 1..7 back via two ports.
            for i in 0 .. 3
                dut.read0_addr = i * 2 + 1     // 1, 3, 5
                dut.read1_addr = i * 2 + 2     // 2, 4, 6
                wait 1 cycle
                let got0 = dut.read0_data
                let got1 = dut.read1_data
                let exp0 = ((i * 2 + 1) * 11 + 5) & 255
                let exp1 = ((i * 2 + 2) * 11 + 5) & 255
                assert got0 == exp0 else fail("port0 read[${i}]: got=${got0} exp=${exp0}")
                assert got1 == exp1 else fail("port1 read[${i}]: got=${got1} exp=${exp1}")
            end for

            // Read addr 7 on its own; pair with addr 0 (must stay zero).
            dut.read0_addr = 7
            dut.read1_addr = 0
            wait 1 cycle
            assert dut.read0_data == ((7 * 11 + 5) & 255)
                else fail("port0 read[7]: got=${dut.read0_data}")
            assert dut.read1_data == 0
                else fail("reg[0] should be hardwired zero, got ${dut.read1_data}")
            log(info, "PASS: regs 1..7 read correctly, reg[0] stays zero")

            // write_before_read forwarding: same-cycle write+read should
            // see the new value.
            dut.write_en = 1
            dut.write_addr = 5
            dut.write_data = 190    // 0xBE
            dut.read0_addr = 5
            dut.read1_addr = 0
            wait 1 cycle
            assert dut.read0_data == 190
                else fail("forwarding: got 0x${dut.read0_data:02x}, expected 0xBE")
            log(info, "PASS: forwarding write_before_read")

            dut.write_en = 0
        end run
    end scope sim
end test IntRegsTest
