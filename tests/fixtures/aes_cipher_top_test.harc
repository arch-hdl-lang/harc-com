// HARC port of arch-com/tests/aes/aes_cipher_top_tb.cpp.
//
// AES-128 encryption: iterative 10-round cipher, ~12 cycles
// after `ld` (1 latency cycle for the load + 1 init cycle + 10
// rounds; `done` rises at the final-round write-back).
//
// Drives the DUT's 128-bit ports (`key`, `text_in`, `text_out`)
// directly with whole-signal assignment + comparison. HARC's
// runtime helpers (`harc_assign` / `harc_read` from
// `harc_thread_rt.h`) flow values through `_harc_u128` (= GCC/
// clang's `__uint128_t`), and >64-bit hex literals lower to a
// composite `(_harc_u128)hi << 64 | lo` expression at codegen
// time. Mirrors arch-com's `_arch_u128` model.
//
// Test vectors (matching the C++ TB):
//
//   Test 1: NIST FIPS-197 Appendix B
//     key = 0x000102030405060708090a0b0c0d0e0f
//     pt  = 0x00112233445566778899aabbccddeeff
//     ct  = 0x69c4e0d86a7b0430d8cdb78070b4c55a
//
//   Test 2: zero key, zero plaintext
//     ct  = 0x66e94bd4ef8a2c3b884cfa59ca342b2e
//
// Helpers live on a passive transactor (`AesXactor`).

transactor AesXactor
    dut : AesCipherTop

    hookable reset_dut()
        dut.rst = 1
        dut.ld = 0
        dut.key = 0
        dut.text_in = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle
    end reset_dut

    // Drive key + plaintext as whole 128-bit values, pulse `ld`
    // for one cycle.
    hookable load_block(key: uint<128>, text_in: uint<128>)
        dut.key = key
        dut.text_in = text_in
        dut.ld = 1
        wait 1 cycle
        dut.ld = 0
    end load_block

    // Spin up to 14 cycles waiting for `done`. Matches the C++ TB
    // bound. In practice the AES core takes 11 cycles (1 load +
    // 10 rounds, with `done` rising at the final round).
    hookable wait_for_done()
        for _ in 0 .. 14
            if dut.done == 0
                wait 1 cycle
            end if
        end for
    end wait_for_done
end transactor AesXactor

test AesCipherTopTest
    let dut  : AesCipherTop
    let xact : AesXactor passive

    scope sim
        run
            log(info, "AES-128 encryption test (FIPS-197 + zero vector)")
            xact.dut = dut

            // ── Test 1: NIST FIPS-197 Appendix B ──────────────────
            xact.reset_dut()
            xact.load_block(
                0x000102030405060708090a0b0c0d0e0f,
                0x00112233445566778899aabbccddeeff
            )
            xact.wait_for_done()

            assert dut.done == 1
                else fail("Test 1: done never asserted within 14 cycles")
            assert dut.text_out == 0x69c4e0d86a7b0430d8cdb78070b4c55a
                else fail("Test 1: text_out=0x${dut.text_out:032x}, expected 0x69c4e0d86a7b0430d8cdb78070b4c55a")
            log(info, "Test 1 PASS: ciphertext = 69c4e0d8_6a7b0430_d8cdb780_70b4c55a")

            // ── Test 2: zero key, zero plaintext ──────────────────
            xact.reset_dut()
            xact.load_block(0, 0)
            xact.wait_for_done()

            assert dut.done == 1
                else fail("Test 2: done never asserted within 14 cycles")
            // AES-128(key=0, pt=0) = 0x66e94bd4ef8a2c3b884cfa59ca342b2e
            assert dut.text_out == 0x66e94bd4ef8a2c3b884cfa59ca342b2e
                else fail("Test 2: text_out=0x${dut.text_out:032x}, expected 0x66e94bd4ef8a2c3b884cfa59ca342b2e")
            log(info, "Test 2 PASS: ciphertext = 66e94bd4_ef8a2c3b_884cfa59_ca342b2e")

            log(info, "ALL 2 SUB-TESTS PASSED — AES-128 cipher")
        end run
    end scope sim
end test AesCipherTopTest
