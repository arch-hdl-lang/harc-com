// Wrapping arithmetic operators `+% / -% / *%` (harc#473).
//
// SEMANTICS: `a OP% b` masks the result to `max(W(a), W(b))` bits — the
// wider operand's width, with no widening — matching ARCH's
// `AddWrap / SubWrap / MulWrap`. The mask is the unsigned low-W residue.
// Operand widths must be statically known: a typed local (`let x : uint<N>`),
// a cast (`x as uint<N>`), a width method, or an integer literal (self-sized
// to its minimum width). A bare DUT-port operand is width-erased in HARC, so
// cast it first (`(dut.count as uint<8>) +% 1`); an operand of unknown width
// is a hard lowering error rather than a silent no-wrap.
//
// This fixture is registered in tests/run_fixtures.sh, so the asserted wrap
// values are checked at RUNTIME under `harc sim`, and in
// tests/tbir_equiv_fixtures.txt, so both emitters must agree on every value
// it covers. v1 used to treat `+%` as pass-through sugar — masking only in
// tbir — which made this fixture a by-design divergence; v1 now emits the
// same `max(W(lhs), W(rhs))` mask.
//
// The shapes below are unsigned with typed destinations, which is where the
// two backends are known to agree. They are NOT the whole operand space: the
// backends infer operand widths in separate code, and a `sint<N>` wrap
// destination is still rejected by tbir and accepted by v1. See spec §2.4's
// caveat list before reading this fixture as proof of full parity.

test WrappingArithmeticOperatorTest
    let dut : Top
    run
        let a : uint<8> = 255

        // 8-bit add wrap: 255 + 1 = 256 -> 0.
        let sum : uint<8> = a +% 1
        assert sum == 0 else fail("255 +% 1 must wrap to 0 at 8 b, got ${sum}")

        // 8-bit mul wrap: 255 * 3 = 765 = 0x2FD -> 0xFD = 253.
        let prod : uint<8> = a *% 3
        assert prod == 253 else fail("255 *% 3 must wrap to 253 at 8 b, got ${prod}")

        // 8-bit sub wrap: 0 - 1 = -1 -> 0xFF = 255.
        let zero : uint<8> = 0
        let diff : uint<8> = zero -% 1
        assert diff == 255 else fail("0 -% 1 must wrap to 255 at 8 b, got ${diff}")

        // Width is max(W(lhs), W(rhs)); the wider typed operand wins.
        // 12-bit wrap: 4095 + 1 = 4096 -> 0.
        let big  : uint<12> = 4095
        let bigw : uint<12> = big +% 1
        assert bigw == 0 else fail("4095 +% 1 must wrap to 0 at 12 b, got ${bigw}")

        // Contrast: the non-wrapping `+` does NOT mask — 255 + 1 widens
        // to 256 in the 9-bit destination.
        let plain : uint<9> = (a as uint<9>) + 1
        assert plain == 256 else fail("`+` must not wrap, got ${plain}")

        // Explicit `.trunc<N>()` still gives a genuine N-bit wrap and now
        // agrees with `+%` at the same width.
        let trunc8 : uint<8> = (a + 1).trunc<8>()
        assert trunc8 == sum else fail(".trunc<8>() and +% must agree, got ${trunc8} vs ${sum}")

        log(info, "PASS: wrapping operators mask to the wider operand width")
    end run
end test WrappingArithmeticOperatorTest
