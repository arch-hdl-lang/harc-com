const YES : bool = true
const NO : bool = false

transaction PredicateEq
    x : uint<8>
    keep (x == 1) == YES
end transaction PredicateEq

transaction PredicateEqLiteral
    x : uint<8>
    keep (x == 1) == true
end transaction PredicateEqLiteral

transaction PredicateEqFalse
    x : uint<8>
    keep (x == 1) == NO
end transaction PredicateEqFalse

transaction PredicateEqNumeric
    x : uint<8>
    keep (x == 1) == 1
end transaction PredicateEqNumeric

transaction DirectPredicate
    x : uint<8>
    keep (x == 1)
end transaction DirectPredicate

transaction LogicalPredicate
    x : uint<8>
    keep (x == 1) && true
end transaction LogicalPredicate

transaction UnsatisfiablePredicate
    x : uint<8>
    keep (x == 1) == true
    keep x == 2
end transaction UnsatisfiablePredicate

test Sat
    let dut : Top
    run
        let a : PredicateEq
        randomize(a)
        assert a.x == 1
        let b : PredicateEqLiteral
        randomize(b)
        assert b.x == 1
        let e : PredicateEqFalse
        randomize(e)
        assert e.x != 1
        let f : PredicateEqNumeric
        randomize(f)
        assert f.x == 1
        let c : DirectPredicate
        randomize(c)
        assert c.x == 1
        let d : LogicalPredicate
        randomize(d)
        assert d.x == 1
    end run
end test Sat

test Unsat
    let dut : Top
    run
        let t : UnsatisfiablePredicate
        randomize(t)
    end run
end test Unsat
