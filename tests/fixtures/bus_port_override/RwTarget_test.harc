// E2E proof for fix/bus-port-override-from-archi.
//
// DUT module RwTarget declares `port s: target BusRw<WRITE=0>`, so `arch build`
// flattens `s` WITHOUT the WRITE-gated aw/w channels. This testbench binds the
// whole bus to the DUT (`let s : BusRw = bind dut`) and does NOT restate the
// override. Before this fix, harc modeled the WRITE channel (bus defaults
// WRITE=1) and diverged from the SV backend (which has no s_aw_* / s_w_* ports);
// after the fix harc ingests the DUT-port override from the .archi and models
// the same READ-only port set, so both backends agree.

// Bus declaration inlined so harc knows the channel/signal set (matches
// BusRw.arch). Its `generate_if WRITE` / `generate_if READ` gates are what the
// DUT-port override (`<WRITE=0>`) selects against.
bus BusRw
  param ADDR_W: const = 32;
  param DATA_W: const = 32;
  param READ:  const = 1;
  param WRITE: const = 1;
  generate_if WRITE
    aw_valid: out Bool;
    aw_ready: in  Bool;
    aw_addr:  out UInt<ADDR_W>;
    w_valid:  out Bool;
    w_ready:  in  Bool;
    w_data:   out UInt<DATA_W>;
  end generate_if
  generate_if READ
    ar_valid: out Bool;
    ar_ready: in  Bool;
    ar_addr:  out UInt<ADDR_W>;
    r_valid:  in  Bool;
    r_ready:  out Bool;
    r_data:   in  UInt<DATA_W>;
  end generate_if
end bus BusRw

testbench RwTargetTb
    dut : RwTarget
end testbench RwTargetTb

impl RwTargetTest for RwTargetTb
    let s : BusRw = bind dut

    run
        dut.rst = 0
        s.ar_valid = 0
        s.r_ready  = 1
        wait 2 cycles
        dut.rst = 1
        wait 1 cycle

        // Drive the read-address channel; check the comb response.
        s.ar_addr  = 42
        s.ar_valid = 1
        wait 1 cycle
        assert dut.busy == 1 else fail("busy should be high when ar_valid")
        assert s.r_valid == 1 else fail("r_valid should mirror ar_valid")
        s.ar_valid = 0
        wait 2 cycles
    end run
end impl RwTargetTest
