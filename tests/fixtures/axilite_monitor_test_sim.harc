// Test scope: declare scoreboard + monitor instances, wire monitor →
// scoreboard via on-handlers at test scope (could move into the
// scoreboard's body in the future once we add monitor-style on-handlers
// inside scoreboard declarations). The test body itself just drives
// register writes and reads — no manual `emit`s required.

extend AxiLiteMonTest
    let sb : MonSb
    let mon : AxiLiteMon

    // Wire monitor outputs → scoreboard. Each write the DUT acks pushes
    // onto the queue; each read the DUT returns pops + compares.
    on mon.write_seen(v)
        sb.expected.push(v)
    end on

    on mon.read_seen(v)
        let exp = sb.expected.pop()
        sb.pairs = sb.pairs + 1
        assert v == exp else fail("scoreboard mismatch: read 0x${v:08x} expected 0x${exp:08x}")
    end on

    on mon.rst_release(_)
        sb.resets = sb.resets + 1
    end on

    scope sim
        run
            log(info, "starting AxiLiteRegs monitor-driven scoreboard test")

            // ── Reset ────────────────────────────────────────────────────
            dut.rst = 1
            dut.axil_aw_addr = 0
            dut.axil_aw_valid = 0
            dut.axil_w_data = 0
            dut.axil_w_strb = 15
            dut.axil_w_valid = 0
            dut.axil_b_ready = 1
            dut.axil_ar_addr = 0
            dut.axil_ar_valid = 0
            dut.axil_r_ready = 1
            dut.mm2s_done = 0
            dut.mm2s_halted = 1
            dut.mm2s_idle = 1
            dut.s2mm_done = 0
            dut.s2mm_halted = 1
            dut.s2mm_idle = 1
            dut.mm2s_sg_done = 0
            dut.s2mm_sg_done = 0
            dut.mm2s_sg_active = 0
            dut.s2mm_sg_active = 0
            wait 2 cycles
            dut.rst = 0
            wait 1 cycle

            // ── 5 random write/read pairs — pure stimulus, no manual emits.
            for i in 0 .. 5
                let t : RegOp
                randomize(t)
                t.addr = 24
                axil_write(dut, t.addr, t.value)
                let got = axil_read(dut, t.addr)
                logf("axi_master.log", info,
                     "stim[${i}] addr=0x${t.addr:02x} wrote=0x${t.value:08x} read=0x${got:08x}")
            end for
        end run

        check
            assert sb.expected.empty() else fail("queue not drained: ${sb.expected.size()} left")
            assert sb.pairs == 5 else fail("expected 5 paired R/W operations, saw ${sb.pairs}")
            assert sb.resets == 1 else fail("expected 1 reset-release event (falling), saw ${sb.resets}")
            log(info, "PASS: ${sb.pairs} W/R pairs + ${sb.resets} reset-release verified by monitor + sb")
        end check
    end scope sim
end extend AxiLiteMonTest
