// AxiLiteRegs test demonstrating sequencer → driver dispatch through
// events. Replaces the "method-call" shape from axilite_driver_test
// with the "event-driven" shape the spec actually mandates for
// drivers (§8.2).
//
// Pattern:
//   sequencer Seq
//       dispatched : out event<RegOp>
//       hookable run(seq: TSeq<RegOp>)  // iterates the tseq, emits each
//   end sequencer Seq
//
//   driver Drv
//       req : in event<RegOp>             // input event
//       dut : DUT
//       on req(t)                         // fires on each emit
//           ...drive dut signals...
//       end on
//   end driver Drv
//
//   test
//       env.seq.dispatched is wired to env.drv.req via an explicit
//       emit chain in the test body (full `connect` block is a
//       follow-up; for now the test wires manually through the
//       sequencer's run method, which emits to dispatched, which
//       the test re-emits to drv.req — same shape, just visible).

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction RegOp

driver SeqDrv
    req : in event<RegOp>
    dut : AxiLiteRegs
    // `last_read` is a shared field that the on-handler writes and
    // the test reads — demonstrates that field assignment inside an
    // on-handler closure flows back to the struct.
    last_read : uint<32> default 0

    // Each `emit drv.req(t)` fires this body once. The body drives
    // the AXI-Lite write/read cycle synchronously. Calling `wait` is
    // legal inside the body — the surrounding `tick()` from the test
    // scope is captured via `[&]` by the registered closure.
    on req(t)
        // Write phase
        dut.axil_aw_addr = t.addr
        dut.axil_aw_valid = 1
        dut.axil_w_data = t.value
        dut.axil_w_strb = 15
        dut.axil_w_valid = 1
        wait 10 cycles
        dut.axil_aw_valid = 0
        dut.axil_w_valid = 0
        wait 2 cycles

        // Read phase — store result in `last_read` so the test can
        // observe the round-trip.
        let val = 0
        let saw = 0
        dut.axil_ar_addr = t.addr
        dut.axil_ar_valid = 1
        for _ in 0 .. 10
            wait 1 cycle
            if dut.axil_r_valid
                if saw == 0
                    val = dut.axil_r_data
                    dut.axil_ar_valid = 0
                    saw = 1
                end if
            end if
        end for
        dut.axil_ar_valid = 0
        wait 1 cycle
        last_read = val
    end on
end driver SeqDrv

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test AxiLiteSeqDrvTest
    let dut : AxiLiteRegs
    let drv : SeqDrv

    scope sim
        run
            log(info, "AxiLiteRegs sequencer → driver event-driven test")
            drv.dut = dut

            // Reset.
            dut.rst = 1
            dut.axil_aw_addr = 0
            dut.axil_aw_valid = 0
            dut.axil_w_data = 0
            dut.axil_w_strb = 15
            dut.axil_w_valid = 0
            dut.axil_b_ready = 1
            dut.axil_ar_addr = 0
            dut.axil_ar_valid = 0
            dut.axil_r_ready = 1
            dut.mm2s_done = 0
            dut.mm2s_halted = 1
            dut.mm2s_idle = 1
            dut.s2mm_done = 0
            dut.s2mm_halted = 1
            dut.s2mm_idle = 1
            dut.mm2s_sg_done = 0
            dut.s2mm_sg_done = 0
            dut.mm2s_sg_active = 0
            dut.s2mm_sg_active = 0
            wait 2 cycles
            dut.rst = 0
            wait 1 cycle

            // Iterate the tseq, emitting each transaction onto the
            // driver's req event. The driver's `on req(t)` handler
            // fires synchronously, drives the bus, and stashes the
            // observed read into drv.last_read.
            let txns = RandomTxns(5)
            let i = 0
            for t in txns
                emit drv.req(t)
                logf("axi_master.log", info,
                     "seqdrv[${i}] addr=0x${t.addr:02x} wrote=0x${t.value:08x} got=0x${drv.last_read:08x}")
                assert drv.last_read == t.value
                    else fail("seqdrv[${i}] mismatch: wrote 0x${t.value:08x} got 0x${drv.last_read:08x}")
                i = i + 1
            end for

            log(info, "PASS: 5 sequencer→driver round-trips via event dispatch")
        end run
    end scope sim
end test AxiLiteSeqDrvTest
