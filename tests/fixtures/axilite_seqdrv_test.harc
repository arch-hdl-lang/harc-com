// Sequencer → transactor event dispatch, *unbound* form. The
// transactor has no `bound to BusType` clause — it pokes raw DUT
// signals directly. Useful when there's no canonical bus type in
// scope, or when the active half also needs to drive sideband
// signals that aren't part of the bus.
//
// Pattern:
//   transactor SeqXactor          // no `bound to`
//       dut : DUT
//       when active
//           req : in event<RegOp>
//           on req(t) ...drive dut signals... end on
//       end when
//   end transactor SeqXactor
//
//   let drv : SeqXactor active    // no `= bind ...`
//
// The test scope iterates a tseq and emits each transaction onto
// `drv.req`; the active driver coroutine fires synchronously per
// emit.

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction RegOp

transactor SeqXactor
    dut : AxiLiteRegs
    last_read : uint<32> default 0

    when active
        req : in event<RegOp>

        // Each `emit drv.req(t)` fires this body once. The body
        // drives the AXI-Lite write/read cycle synchronously
        // through raw DUT signals (no bus type — this transactor
        // is unbound).
        on req(t)
            // Write phase
            dut.axil_aw_addr = t.addr
            dut.axil_aw_valid = 1
            dut.axil_w_data = t.value
            dut.axil_w_strb = 15
            dut.axil_w_valid = 1
            wait 10 cycles
            dut.axil_aw_valid = 0
            dut.axil_w_valid = 0
            wait 2 cycles

            // Read phase — store result in `last_read` so the test
            // can observe the round-trip.
            let val = 0
            let saw = 0
            dut.axil_ar_addr = t.addr
            dut.axil_ar_valid = 1
            for _ in 0 .. 9
                wait 1 cycle
                if dut.axil_r_valid
                    if saw == 0
                        val = dut.axil_r_data
                        dut.axil_ar_valid = 0
                        saw = 1
                    end if
                end if
            end for
            dut.axil_ar_valid = 0
            wait 1 cycle
            last_read = val
        end on
    end when
end transactor SeqXactor

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 1 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

testbench AxiLiteSeqDrvTb
    dut : AxiLiteRegs
    drv : SeqXactor active
end testbench AxiLiteSeqDrvTb

impl AxiLiteSeqDrvTest for AxiLiteSeqDrvTb

    run
        log(info, "AxiLiteRegs sequencer → transactor (unbound) event-driven test")
        drv.dut = dut

        // Reset.
        dut.rst = 1
        dut.axil_aw_addr = 0
        dut.axil_aw_valid = 0
        dut.axil_w_data = 0
        dut.axil_w_strb = 15
        dut.axil_w_valid = 0
        dut.axil_b_ready = 1
        dut.axil_ar_addr = 0
        dut.axil_ar_valid = 0
        dut.axil_r_ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Iterate the tseq, emitting each transaction onto the
        // transactor's req event. The active half fires
        // synchronously, drives the bus, and stashes the
        // observed read into drv.last_read.
        let txns = RandomTxns(5)
        let i = 0
        for t in txns
            emit drv.req(t)
            logf("axi_master.log", info,
                 "seqdrv[${i}] addr=0x${t.addr:02x} wrote=0x${t.value:08x} got=0x${drv.last_read:08x}")
            assert drv.last_read == t.value
                else fail("seqdrv[${i}] mismatch: wrote 0x${t.value:08x} got 0x${drv.last_read:08x}")
            i = i + 1
        end for

        log(info, "PASS: 5 sequencer→transactor round-trips via event dispatch")
    end run
end impl AxiLiteSeqDrvTest

