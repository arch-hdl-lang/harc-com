// End-to-end demo of transaction-level `keep` constraints feeding
// through bare `randomize(t)` (spec §4). Verifies that the keep
// blocks aren't silently dropped: every randomized value must
// satisfy every keep, asserted at runtime.
//
// Before the §4 fix, this test would fail on most iterations —
// `randomize(t)` would produce uniformly-random values across the
// field's full width, ignoring `keep len in [1..16]` entirely.
// After the fix, each randomized value flows through Z3 with the
// keeps enabled, so the asserts always hold.
//
// The DUT is unused here (we're not driving any pins); `Top` is
// chosen because it's already in the verilator regression and
// gives us a clock.

domain SysDomain
  freq_mhz: 100
end domain SysDomain

enum Color { RED, GREEN, BLUE }

transaction Req
    len   : uint<8>
    addr  : uint<32>
    color : Color
    ready : uint<1>

    // Range membership: 1..16 inclusive.
    keep len in [1..16]
    // Cross-field arithmetic: addr must be 4-byte aligned.
    keep addr % 4 == 0
    // Enum exclusion: NEVER produce RED (index 0).
    keep color != RED
    // A bare one-bit unsigned field IS a condition — `keep ready` means
    // `ready != 0`. It is the only constraint shape that is not already a
    // comparison, and it used to be emitted as a raw bitvector handed to
    // `z3::solver::add`, which takes a Bool: it built and then died as a
    // Z3 sort error at runtime (harc#560). The typed constraint IR
    // rejected it outright, which is what kept this line out of the corpus
    // until harc#596.
    keep ready
end transaction Req

testbench KeepConstraintsTb
    dut : Top
end testbench KeepConstraintsTb

impl KeepConstraintsTest for KeepConstraintsTb
    clock clk = SysDomain

    run
        dut.rst = 1
        dut.en = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Randomize 30 transactions, asserting each one satisfies
        // the full keep set. Before the §4 fix, len would typically
        // exceed 16 and addr would not be 4-aligned and color could
        // be RED — any one of those would fail.
        for i in 0 .. 29
            let t : Req
            randomize(t)

            assert t.len >= 1 && t.len <= 16
                else fail("iter ${i}: len=${t.len} violates `keep len in [1..16]`")
            assert t.addr % 4 == 0
                else fail("iter ${i}: addr=0x${t.addr:08x} not 4-aligned")
            // RED = 0 (first variant). The codegen translates
            // `color != RED` to `_z_color != bv_val(0)`.
            assert t.color != 0
                else fail("iter ${i}: color=RED violates `keep color != RED`")
            // `keep ready` coerces to `ready != 0`, so on one bit the only
            // satisfying value is 1.
            assert t.ready == 1
                else fail("iter ${i}: ready=${t.ready} violates bare `keep ready`")
        end for

        log(info, "PASS: 30 randomize(t) calls satisfied every keep constraint")
    end run
end impl KeepConstraintsTest

