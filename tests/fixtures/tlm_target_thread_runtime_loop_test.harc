// Target-side TLM responder runtime-loop test.
//
// The SV DUT issues two blocking read requests with different runtime `len`
// values. The HARC target responder computes a response accumulator with
// `for i in 0 .. len` before the terminal conditional return.

bus TlmMemBus
    tlm_method read(addr: uint<8>, len: uint<4>) -> uint<32>: blocking;
end bus TlmMemBus

transactor TlmMemTarget bound to TlmMemBus
    read_count : uint<32> default 0
    prep_acc : uint<32> default 0

    thread bus.read(addr: uint<8>, len: uint<4>)
        let req_seq : uint<32> = read_count
        read_count = read_count + 1
        prep_acc = 0
        // len >= 1 for this test (DUT issues looping reads); inclusive range needs len-1
        for i in 0 .. len - 1
            prep_acc = prep_acc + addr + i
        end for
        wait 1 cycle
        if addr < 8
            return 256 + prep_acc + req_seq
        else
            return 512 + prep_acc + req_seq
        end if
    end thread
end transactor TlmMemTarget

testbench TlmTargetThreadRuntimeLoopTb
    dut : TlmReadInitiatorRuntimeLen
end testbench TlmTargetThreadRuntimeLoopTb

impl TlmTargetThreadRuntimeLoopTest for TlmTargetThreadRuntimeLoopTb
    let mem : TlmMemBus = bind dut
    let target : TlmMemTarget passive = bind mem

    run
        dut.rst = 1
        wait 2 cycles
        dut.rst = 0

        wait until dut.done == 1 timeout 100 cycles fail("DUT initiator did not receive both runtime-loop target responses")
        assert dut.result0 == 274
            else fail("first runtime-loop target TLM response mismatch got=0x${dut.result0:08x}, expected 0x00000112")
        assert dut.result1 == 583
            else fail("second runtime-loop target TLM response mismatch got=0x${dut.result1:08x}, expected 0x00000247")
        assert target.read_count == 2
            else fail("target TLM read_count mismatch got=${target.read_count}, expected 2")
        assert target.prep_acc == 70
            else fail("target TLM prep_acc mismatch got=${target.prep_acc}, expected 70")

        log(info, "PASS: HARC target-side TLM thread used runtime loop bound")
    end run
end impl TlmTargetThreadRuntimeLoopTest
