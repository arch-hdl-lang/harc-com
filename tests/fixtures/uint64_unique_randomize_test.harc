// Regression fixture for issue #167: uint<64> fields with [unique] should
// keep their high auto-coverage endpoints without relying on Z3's asserting
// get_numeral_uint64() extraction path.
//
// The structural half of this regression lives in
// tests/codegen.rs::uint64_unique_randomize_uses_checked_model_extraction,
// which asserts the *shape* of the emitted C++. That cannot catch a bug in
// the extraction helper itself (`harc_z3_bv_low_u64` in
// runtime/harc_z3_rt.h) — the emitted call site reads identically either
// way. This fixture is the behavioral half: it runs the emitted code against
// a real Z3 and asserts that values above 2^32 actually come back.
//
// The teeth are in `cp_high_half`. Truncating the extraction to 32 bits —
// the #167 bug class — leaves every drawn value in the `zero` bin, so the
// `nonzero` assertion below fails. Verified by mutating harc_z3_bv_low_u64.

domain SysDomain
  freq_mhz: 100
end domain SysDomain

// The reference helper makes the uniqueness policy observable: HARC's
// queue subset has no membership query, so the C++ model records each value
// and rejects repeats within this test process.
extern function ref_unique_u8(value: uint<8>) -> uint<1>
extern function ref_unique_multi_u8(value: uint<8>) -> uint<1>

transaction Uint64UniqueStim
    data : uint<64> with [unique within test]
    sample : uint<64>
end transaction Uint64UniqueStim

// Keep the bounded uniqueness probe at a separate randomize site so its
// auto-coverage goals do not compete with the high-half regression's goals.
transaction TinyUniqueStim
    token : uint<8> with [dist {[0] :/ 100}] [unique within test]
end transaction TinyUniqueStim

transaction RecycleUniqueStim
    token : uint<2> with [unique within test]
end transaction RecycleUniqueStim

transaction MultiRecycleUniqueStim
    small : uint<2> with [dist {[0] :/ 100}] [unique within test]
    wide  : uint<8> with [dist {[200] :/ 100}] [unique within test]
end transaction MultiRecycleUniqueStim

// Sample the randomized value at each `observe` call. Covering the sample's
// high half directly asserts that model extraction preserves bits 63..32;
// `data` remains unconstrained so its `[unique]` history path stays active.
covergroup Uint64Cov @(obs.observe(s) post)
    cp_high_half : cover s.sample[63:32]
        bins
            zero    = {0}
            nonzero = [1..4294967295]
        end bins
end covergroup Uint64Cov

transactor StimObserver
    dut : Top

    when active
        // Pure observation point — exists so the covergroup has a hook to
        // sample the randomized transaction on.
        hookable observe(s: Uint64UniqueStim)
            wait 1 cycle
        end observe
    end when
end transactor StimObserver

testbench Uint64UniqueTb
    dut : Top
    obs : StimObserver active
    cov : Uint64Cov
end testbench Uint64UniqueTb

impl Uint64UniqueRandomizeTest for Uint64UniqueTb
    clock clk = SysDomain

    run
        obs.dut = dut

        dut.rst = 1
        dut.en = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // The uint<8> auto-coverage plan has 18 targets (0, 255, and the
        // walking-one/walking-zero values). On the 19th call those targets
        // are exhausted, but the 256-value unique history is not; the fixed
        // preference would repeat zero unless [unique] blocks it.
        for i in 0 .. 18
            let tiny : TinyUniqueStim
            randomize(tiny)
            assert ref_unique_u8(tiny.token) == 1
                else fail("uint<8> unique randomize repeated token at iteration ${i}")
        end for

        // A five-value run exhausts the four-value history and verifies that
        // the solver recycles it instead of returning UNSAT.
        for i in 0 .. 4
            let recycle : RecycleUniqueStim
            randomize(recycle)
        end for

        // Recycling `small` must not clear `wide`: the wide field still has
        // unused values when the small field exhausts its four-value domain.
        for i in 0 .. 20
            let multi : MultiRecycleUniqueStim
            randomize(multi)
            assert ref_unique_multi_u8(multi.wide) == 1
                else fail("multi-field unique randomize repeated wide at iteration ${i}")
        end for

        for i in 0 .. 33
            let s : Uint64UniqueStim
            randomize(s) with
                s.sample[63:32] != 0
            end randomize
            obs.observe(s)
        end for
    end run

    check
        cov.report()
        assert cov.cp_high_half.nonzero > 0
            else fail("uint<64> randomize never produced a value above 2^32: model extraction is truncating the high half (issue #167)")
        log(info, "PASS: uint<64> unique randomize preserves the high half")
    end check
end impl Uint64UniqueRandomizeTest
