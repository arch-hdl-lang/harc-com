// Drive a mix of register addresses + random data, then print the
// coverage report at end of test. Tests:
//   - cp_addr should hit 'dmacr', 'sa', 'length' (3 of 4 bins, 75%)
//   - cp_data should hit a mix of magnitude bins depending on seed

impl sim for AxiLiteCovTest
    run
        log(info, "starting AxiLiteRegs coverage test")

        // ── Reset ────────────────────────────────────────────────────
        dut.rst = 1
        dut.axil_aw_addr = 0
        dut.axil_aw_valid = 0
        dut.axil_w_data = 0
        dut.axil_w_strb = 15
        dut.axil_w_valid = 0
        dut.axil_b_ready = 1
        dut.axil_ar_addr = 0
        dut.axil_ar_valid = 0
        dut.axil_r_ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // ── Drive a small mix: one DMACR write, one LENGTH write,
        //    plus 3 SA writes with random data magnitudes.
        axil_write(dut, 0, 1)                 // DMACR.RS
        axil_write(dut, 40, 16)               // LENGTH = 16 (tiny)

        for i in 0 .. 3
            let t : RegData
            randomize(t)
            axil_write(dut, 24, t.value)
        end for
    end run

    check
        // The covergroup's report() prints per-bin hit counts + %.
        cov.report()

        // Coverage assertions: addr should have hit the 3 specific
        // RW registers we drove (dmacr, sa, length).
        assert cov.cp_addr.dmacr  > 0 else fail("DMACR write not seen")
        assert cov.cp_addr.sa     > 0 else fail("SA write not seen")
        assert cov.cp_addr.length > 0 else fail("LENGTH write not seen")
        assert cov.cp_addr.other == 0 else fail("unexpected write to non-RW offset")

        log(info, "coverage assertions passed")
    end check
end impl AxiLiteCovTest
