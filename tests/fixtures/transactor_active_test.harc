// T-2 demo: `transactor` lowering against the AxiLiteRegs DUT.
//
// Shows the post-PR-#22 source surface end-to-end: one `transactor`
// with both an always-present observation half and an active-only
// stimulus half, instantiated as `active` so the driver coroutine
// fires. Compares against axilite_bound_drv_test, which uses the
// pre-transactor `driver` form — same DUT, same observable
// behavior, demonstrating the transactor surface is a drop-in
// replacement for the bound driver+monitor split.

use BusAxiLite

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
end transaction RegOp

transactor AxilXactor bound to BusAxiLite
    last_read : uint<32> default 0

    when active
        req : in event<RegOp>

        on req(t)
            bus.aw.addr = t.addr
            bus.aw.valid = 1
            bus.w.send(t.value, 15)
            bus.aw.valid = 0
            wait 2 cycles
            bus.ar.addr = t.addr
            bus.ar.valid = 1
            let beat = bus.r.recv()
            bus.ar.valid = 0
            wait 1 cycle
            last_read = beat.data
        end on
    end when
end transactor AxilXactor

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

testbench TransactorActiveTb
    dut : AxiLiteRegs
    sb  : AxilSb
end testbench TransactorActiveTb

impl TransactorActiveTest for TransactorActiveTb
    let axil : BusAxiLite = bind dut
    let xact : AxilXactor active = bind axil

    run
        log(info, "transactor test — active instance drives via req event")

        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Dispatch 5 transactions through the transactor's active
        // input pipe. Each `emit xact.req(t)` is a non-blocking
        // enqueue handled by the active driver coroutine — same
        // semantics as the pre-transactor bound driver.
        let txns = RandomTxns(5)
        for t in txns
            emit xact.req(t)
            sb.expected.push(t.value)
        end for

        // Drain time. Each round-trip ~7 cycles; 60 gives ample
        // slack.
        wait 60 cycles

        // The transactor's `last_read` field holds the most-
        // recent observed value. Cross-check by popping all
        // expected values; the LAST pop is what xact.last_read
        // should match.
        let final_val = 0
        for t in txns
            final_val = sb.expected.pop()
        end for

        assert xact.last_read == final_val
            else fail("transactor final read=0x${xact.last_read:08x}, expected 0x${final_val:08x}")

        log(info, "PASS: 5 transactions processed by `AxilXactor active`")
    end run
end impl TransactorActiveTest

scoreboard AxilSb
    expected : queue<uint<32>>
end scoreboard AxilSb
