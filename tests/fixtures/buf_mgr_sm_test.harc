// HARC port of arch-com/tests/buf_mgr_sm/buf_mgr_sm_tb.cpp.
//
// BufMgrSm is the small variant of a buffer manager:
//   - 16 entries x 32-bit data
//   - 4 logical queues sharing one free-list and three SRAMs
//     (data, next-pointer, free-list)
//   - latency-2 enqueue (drive *_valid 1 cycle, results visible
//     2 cycles later as count_arr updates)
//   - latency-2 dequeue (drive *_valid 1 cycle, response_valid +
//     data available the cycle after that — DQ0 issues SRAM read,
//     DQ1 surfaces dq2_valid + data on synchronous read port)
//   - 16-cycle internal init phase after reset (`init_done` rises
//     when free-list SRAM has been seeded with all 16 slots)
//
// The HARC version uses an active transactor (`BufMgrXactor`) with
// hookable methods that mirror the C++ TB's `enqueue` / `dequeue` /
// `idle` helpers. The `xact.dut` field is wired once at the top of
// run().
//
// Cycle accounting matches the C++ TB exactly: the C++ test relies
// on `idle(N)` after enqueue/dequeue to let the latency-2 pipeline
// drain (so subsequent reads of `free_count_out` see the updated
// value). HARC uses `wait N cycles` for the same effect.

transactor BufMgrXactor
    dut : BufMgrSm

    when active
        // Reset pulse: hold rst=1 for 2 cycles (matches C++ tick();tick();
        // pattern), then drop. Inputs idled.
        hookable reset_dut()
            dut.rst = 1
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            dut.enqueue_queue_number = 0
            dut.enqueue_data = 0
            dut.dequeue_queue_number = 0
            wait 2 cycles
            dut.rst = 0
        end reset_dut

        // After reset, the free-list SRAM seeds itself over 16 cycles.
        // Spin (up to 100 cycles, like C++) until init_done rises.
        hookable wait_init()
            for _ in 0 .. 99
                if dut.init_done == 0
                    wait 1 cycle
                end if
            end for
        end wait_init

        // Single enqueue: drive valid for 1 cycle, deassert.
        hookable enqueue(qn: uint<2>, data: uint<32>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = qn
            dut.enqueue_data = data
            wait 1 cycle
            dut.enqueue_valid = 0
        end enqueue

        // Dequeue: drive valid for 1 cycle (DQ0 — SRAM read issued),
        // deassert, wait 1 more cycle (DQ1 — dq2_valid + data available).
        // Returns the dequeued data; resp_valid is checked at the call
        // site via dut.dequeue_resp_valid right after.
        hookable dequeue_one(qn: uint<2>) -> uint<32>
            dut.dequeue_valid = 1
            dut.dequeue_queue_number = qn
            wait 1 cycle
            dut.dequeue_valid = 0
            wait 1 cycle
            return dut.dequeue_data
        end dequeue_one

        hookable idle_n(n: uint<32>)
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            for _ in 1 .. n
                wait 1 cycle
            end for
        end idle_n

        // Back-to-back enqueue: hold valid high across `count` cycles,
        // injecting `d0`, `d1`, `d2` (matches the C++ TB's 3-cycle
        // valid-held-high pattern in Test 5). Lives on the transactor so
        // each `wait 1 cycle` rides the synchronous tick() lambda — the
        // run-scope coroutine wait can suspend-and-resume around the same
        // edge, dropping the first sample.
        hookable enqueue_b2b3(qn: uint<2>, d0: uint<32>, d1: uint<32>, d2: uint<32>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = qn
            dut.enqueue_data = d0
            wait 1 cycle
            dut.enqueue_data = d1
            wait 1 cycle
            dut.enqueue_data = d2
            wait 1 cycle
            dut.enqueue_valid = 0
        end enqueue_b2b3

        // Same-cycle enqueue + dequeue (different queues), matching the
        // C++ TB's Test 6 pattern. After this method returns,
        // dut.dequeue_resp_valid + dut.dequeue_data carry the response.
        hookable enqueue_dequeue_simul(eq_qn: uint<2>, eq_data: uint<32>, dq_qn: uint<2>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = eq_qn
            dut.enqueue_data = eq_data
            dut.dequeue_valid = 1
            dut.dequeue_queue_number = dq_qn
            wait 1 cycle
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            wait 1 cycle
        end enqueue_dequeue_simul
    end when
end transactor BufMgrXactor

testbench BufMgrSmTb
    dut  : BufMgrSm
    xact : BufMgrXactor active
end testbench BufMgrSmTb

impl BufMgrSmTest for BufMgrSmTb
    run
        log(info, "BufMgrSm small-variant test (16x32, 4 queues)")
        xact.dut = dut

        // ── Test 1: Reset + Init ────────────────────────────
        xact.reset_dut()
        assert dut.init_done == 0
            else fail("Test 1: init_done=${dut.init_done} expected 0 right after reset")

        xact.wait_init()
        assert dut.init_done == 1
            else fail("Test 1: init_done=${dut.init_done} expected 1 after init")
        assert dut.free_count_out == 16
            else fail("Test 1: free_count=${dut.free_count_out} expected 16 after init")
        log(info, "Test 1 PASS: reset + init_done + free_count==16")

        // ── Test 2: Single enqueue + dequeue (queue 0) ──────
        xact.enqueue(0, 0xDEAD)
        xact.idle_n(4)

        let v2 = xact.dequeue_one(0)
        assert dut.dequeue_resp_valid == 1
            else fail("Test 2: dequeue_resp_valid=${dut.dequeue_resp_valid} expected 1")
        assert v2 == 0xDEAD
            else fail("Test 2: dequeue(q=0) got 0x${v2:08x} expected 0x0000DEAD")
        xact.idle_n(4)
        assert dut.free_count_out == 16
            else fail("Test 2: free_count=${dut.free_count_out} expected 16 after dequeue")
        log(info, "Test 2 PASS: single enqueue/dequeue queue 0")

        // ── Test 3: Multi-queue (q0,q1,q2) ──────────────────
        xact.enqueue(0, 0x100)
        xact.enqueue(1, 0x200)
        xact.enqueue(2, 0x300)
        xact.idle_n(6)
        assert dut.free_count_out == 13
            else fail("Test 3: free_count=${dut.free_count_out} expected 13 after 3 enqueues")

        let v3a = xact.dequeue_one(0)
        assert v3a == 0x100
            else fail("Test 3: dequeue(q=0) got 0x${v3a:08x} expected 0x100")
        xact.idle_n(2)
        let v3b = xact.dequeue_one(1)
        assert v3b == 0x200
            else fail("Test 3: dequeue(q=1) got 0x${v3b:08x} expected 0x200")
        xact.idle_n(2)
        let v3c = xact.dequeue_one(2)
        assert v3c == 0x300
            else fail("Test 3: dequeue(q=2) got 0x${v3c:08x} expected 0x300")
        xact.idle_n(4)
        assert dut.free_count_out == 16
            else fail("Test 3: free_count=${dut.free_count_out} expected 16 after 3 dequeues")
        log(info, "Test 3 PASS: multi-queue independence (q0,q1,q2)")

        // ── Test 4: FIFO order, 4 items to queue 3 ─────────
        xact.enqueue(3, 0xA0)
        xact.enqueue(3, 0xA1)
        xact.enqueue(3, 0xA2)
        xact.enqueue(3, 0xA3)
        xact.idle_n(6)
        assert dut.free_count_out == 12
            else fail("Test 4: free_count=${dut.free_count_out} expected 12 after 4 enqueues")

        for i in 0 .. 3
            let vi = xact.dequeue_one(3)
            let expected = 0xA0 + i
            assert vi == expected
                else fail("Test 4: dequeue(q=3)[${i}] got 0x${vi:08x} expected 0x${expected:08x}")
            xact.idle_n(2)
        end for
        assert dut.free_count_out == 16
            else fail("Test 4: free_count=${dut.free_count_out} expected 16 after 4 dequeues")
        log(info, "Test 4 PASS: FIFO order on queue 3")

        // ── Test 5: Back-to-back enqueue queue 1 ────────────
        // Hold enqueue_valid high across 3 cycles, varying data.
        xact.enqueue_b2b3(1, 0xB0, 0xB1, 0xB2)
        xact.idle_n(6)
        assert dut.free_count_out == 13
            else fail("Test 5: free_count=${dut.free_count_out} expected 13 after 3 b2b enqueues")

        let v5a = xact.dequeue_one(1)
        assert v5a == 0xB0
            else fail("Test 5: dequeue(q=1)[0] got 0x${v5a:08x} expected 0xB0")
        xact.idle_n(2)
        let v5b = xact.dequeue_one(1)
        assert v5b == 0xB1
            else fail("Test 5: dequeue(q=1)[1] got 0x${v5b:08x} expected 0xB1")
        xact.idle_n(2)
        let v5c = xact.dequeue_one(1)
        assert v5c == 0xB2
            else fail("Test 5: dequeue(q=1)[2] got 0x${v5c:08x} expected 0xB2")
        xact.idle_n(4)
        assert dut.free_count_out == 16
            else fail("Test 5: free_count=${dut.free_count_out} expected 16 after b2b drain")
        log(info, "Test 5 PASS: back-to-back enqueue holds valid")

        // ── Test 6: Simultaneous enqueue(q3) + dequeue(q2) ──
        xact.enqueue(2, 0xC0)
        xact.idle_n(6)

        // Same-cycle assertion of both valids targeting different
        // queues. The C++ TB drives both for one cycle, then
        // deasserts and waits one more for the dequeue response.
        xact.enqueue_dequeue_simul(3, 0xC1, 2)
        assert dut.dequeue_resp_valid == 1
            else fail("Test 6: simul dequeue resp_valid=${dut.dequeue_resp_valid} expected 1")
        assert dut.dequeue_data == 0xC0
            else fail("Test 6: simul dequeue(q=2) got 0x${dut.dequeue_data:08x} expected 0xC0")
        xact.idle_n(6)

        let v6 = xact.dequeue_one(3)
        assert v6 == 0xC1
            else fail("Test 6: dequeue(q=3) after simul-enq got 0x${v6:08x} expected 0xC1")
        xact.idle_n(4)
        assert dut.free_count_out == 16
            else fail("Test 6: free_count=${dut.free_count_out} expected 16 after simul test")
        log(info, "Test 6 PASS: simultaneous enqueue + dequeue (different queues)")

        log(info, "ALL 6 SUB-TESTS PASSED — BufMgrSm coverage")
    end run
end impl BufMgrSmTest

