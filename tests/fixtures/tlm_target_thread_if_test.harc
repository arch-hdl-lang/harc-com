// Target-side TLM responder branch test.
//
// The SV DUT issues two blocking read requests. The passive HARC target
// branches on the captured request address and returns a different response
// range for each branch.

bus TlmMemBus
    tlm_method read(addr: uint<8>) -> uint<32>: blocking;
end bus TlmMemBus

transactor TlmMemTarget bound to TlmMemBus
    thread bus.read(addr: uint<8>)
        wait 1 cycle
        if addr < 8
            return 256 + addr
        else
            return 512 + addr
        end if
    end thread
end transactor TlmMemTarget

testbench TlmTargetThreadIfTb
    dut : TlmReadInitiatorPair
end testbench TlmTargetThreadIfTb

impl TlmTargetThreadIfTest for TlmTargetThreadIfTb
    let mem : TlmMemBus = bind dut
    let target : TlmMemTarget passive = bind mem

    run
        dut.rst = 1
        wait 2 cycles
        dut.rst = 0

        wait until dut.done == 1 timeout 80 cycles fail("DUT initiator did not receive both HARC target responses")
        assert dut.result0 == 261
            else fail("first target TLM response mismatch got=0x${dut.result0:08x}, expected 0x00000105")
        assert dut.result1 == 524
            else fail("second target TLM response mismatch got=0x${dut.result1:08x}, expected 0x0000020c")

        log(info, "PASS: HARC target-side TLM thread branched on request address")
    end run
end impl TlmTargetThreadIfTest
