// HARC port of arch-com/tests/buf_mgr/buf_mgr_tb.cpp.
//
// BufMgr — 256-queue shared buffer manager:
//   - 16K x 128b data pool, singly-linked list per queue.
//   - Sub-components: DataMem, NextPtrMem, FreeListBank x 2 (all sync_out,
//     2-cycle read latency).
//   - Free-list uses 2-bank interleaving + 4-entry prefetch FIFO so EQ0 can
//     allocate one free slot per cycle once primed.
//   - 3-stage enqueue pipeline (EQ0→EQ1→EQ2), 3-stage dequeue pipeline
//     (DQ0→DQ1→DQ2). `init_done` deasserted until the SetupCounter has
//     populated all 16K free-list entries AND the prefetch FIFO has at
//     least 2 slots (≈16386+ cycles after reset).
//
// The C++ TB exists in two near-identical forms (buf_mgr_tb.cpp and
// buf_mgr_vl_tb.cpp); the only difference is `unique_ptr<VBufMgr>` vs a
// static instance + `Verilated::commandArgs`. Same 7 sub-tests, same
// scenarios, same assertions. We port them as a single HARC fixture.
//
// Tests (matching the C++ structure):
//   1. Reset + init_done flip + free_count == 16384.
//   2. Single enqueue/dequeue on queue 0.
//   3. Multi-queue: enqueue 0/1/2, dequeue each.
//   4. FIFO order: 4 items to queue 5.
//   5. Back-to-back enqueue (valid held across 3 cycles).
//   6. Simultaneous enqueue + dequeue on different queues.
//   7. High queue numbers (q=255, q=128).
//
// Helpers live on an active `BufMgrXactor` (cpu_pipeline / mshr_cocotb
// pattern). Tests only inspect the low 32 bits of the 128-bit data port,
// matching the C++ TB's `set_data(lo)` / `dequeue_data._data[0]` shape.

transactor BufMgrXactor
    dut : BufMgr

    when active
        hookable init_dut()
            dut.rst = 0
            dut.enqueue_valid = 0
            dut.enqueue_queue_number = 0
            dut.enqueue_data = 0
            dut.dequeue_valid = 0
            dut.dequeue_queue_number = 0
        end init_dut

        // Two-cycle reset pulse (matches the C++ TB's `reset()`: two ticks with
        // rst=1, then drop).
        hookable reset_dut()
            dut.rst = 1
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            wait 2 cycles
            dut.rst = 0
        end reset_dut

        // Wait up to 20000 cycles for init_done. The C++ TB caps at 20000.
        // SetupCounter writes 16384 entries, then the prefetch pipeline needs
        // ~3 cycles to fill the buffer past the threshold (fl_buf_count >= 2).
        hookable wait_init() -> uint<32>
            let cycles = 0
            while !dut.init_done && cycles < 20000
                wait 1 cycle
                cycles = cycles + 1
            end while
            return cycles
        end wait_init

        // Single-cycle enqueue. C++ TB writes only the low 32 bits and zeroes
        // the upper 96; assigning a small constant to the 128-bit port has the
        // same effect.
        hookable enqueue(qn: uint<8>, data_lo: uint<32>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = qn
            dut.enqueue_data = data_lo
            wait 1 cycle
            dut.enqueue_valid = 0
            dut.enqueue_data = 0
        end enqueue

        // Two-tick dequeue: DQ0 issues SRAM reads, DQ1→DQ2 latches the result.
        // dequeue_resp_valid must be 1 in the second cycle; we assert it here
        // so callers can rely on the returned data being meaningful.
        hookable dequeue(qn: uint<8>) -> uint<32>
            dut.dequeue_valid = 1
            dut.dequeue_queue_number = qn
            wait 1 cycle              // DQ0
            dut.dequeue_valid = 0
            wait 1 cycle              // DQ1 → DQ2
            assert dut.dequeue_resp_valid == 1
                else fail("dequeue: resp_valid=0 for queue ${qn}")
            return dut.dequeue_data
        end dequeue

        // Hold all valids low for n cycles. Mirrors the C++ TB's `idle(n)`,
        // used between bursts to let the EQ/DQ pipelines drain.
        hookable idle(n: uint<32>)
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            for _ in 1 .. n
                wait 1 cycle
            end for
        end idle

        // Back-to-back enqueue: hold valid high across 3 cycles, injecting
        // d0/d1/d2. Lives on the transactor (not in run scope) so each
        // `wait 1 cycle` lowers to a synchronous `tick()` in the lambda.
        // The run-scope coroutine path uses `co_await wait_cycles(1)` which
        // resumes BEFORE the next posedge, so the first sample is dropped.
        // (See buf_mgr_sm_test.harc — same workaround.)
        hookable enqueue_b2b3(qn: uint<8>, d0: uint<32>, d1: uint<32>, d2: uint<32>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = qn
            dut.enqueue_data = d0
            wait 1 cycle
            dut.enqueue_data = d1
            wait 1 cycle
            dut.enqueue_data = d2
            wait 1 cycle
            dut.enqueue_valid = 0
            dut.enqueue_data = 0
        end enqueue_b2b3

        // Same-cycle enqueue + dequeue (different queues), matching the
        // C++ TB's Test 6 pattern. After this method returns,
        // dut.dequeue_resp_valid + dut.dequeue_data carry the response.
        hookable enqueue_dequeue_simul(eq_qn: uint<8>, eq_data: uint<32>, dq_qn: uint<8>)
            dut.enqueue_valid = 1
            dut.enqueue_queue_number = eq_qn
            dut.enqueue_data = eq_data
            dut.dequeue_valid = 1
            dut.dequeue_queue_number = dq_qn
            wait 1 cycle
            dut.enqueue_valid = 0
            dut.dequeue_valid = 0
            dut.enqueue_data = 0
            wait 1 cycle              // DQ1 → DQ2 + sync_out
        end enqueue_dequeue_simul
    end when
end transactor BufMgrXactor

testbench BufMgrTb
    dut  : BufMgr
    xact : BufMgrXactor active
end testbench BufMgrTb

impl BufMgrTest for BufMgrTb
    run
        log(info, "BufMgr: 256-queue shared buffer manager — 7 sub-tests")
        xact.dut = dut

        // ── Test 1: Reset + Init ────────────────────────────────
        xact.init_dut()
        xact.reset_dut()
        assert dut.init_done == 0
            else fail("Test 1: init_done=${dut.init_done} after reset, expected 0")

        let init_cycles = xact.wait_init()
        assert dut.init_done == 1
            else fail("Test 1: init_done not asserted after ${init_cycles} cycles")
        assert dut.free_count_out == 16384
            else fail("Test 1: free_count=${dut.free_count_out}, expected 16384")
        log(info, "Test 1 PASS: init_done after ${init_cycles} cycles, free_count=16384")

        // ── Test 2: Single enqueue + dequeue (queue 0) ─────────
        xact.enqueue(0, 0xDEADBEEF)
        xact.idle(4)

        let v2 = xact.dequeue(0)
        assert v2 == 0xDEADBEEF
            else fail("Test 2: dequeue(q=0)=0x${v2:08x}, expected 0xDEADBEEF")
        xact.idle(4)
        log(info, "Test 2 PASS: single enqueue/dequeue queue 0")

        // ── Test 3: Multi-queue ────────────────────────────────
        xact.enqueue(0, 0x100)
        xact.enqueue(1, 0x200)
        xact.enqueue(2, 0x300)
        xact.idle(6)

        let v3a = xact.dequeue(0)
        assert v3a == 0x100
            else fail("Test 3: dequeue(q=0)=0x${v3a:08x}, expected 0x00000100")
        xact.idle(2)
        let v3b = xact.dequeue(1)
        assert v3b == 0x200
            else fail("Test 3: dequeue(q=1)=0x${v3b:08x}, expected 0x00000200")
        xact.idle(2)
        let v3c = xact.dequeue(2)
        assert v3c == 0x300
            else fail("Test 3: dequeue(q=2)=0x${v3c:08x}, expected 0x00000300")
        xact.idle(4)
        log(info, "Test 3 PASS: multi-queue enqueue/dequeue (q0,q1,q2)")

        // ── Test 4: FIFO order — 4 items to queue 5 ────────────
        xact.enqueue(5, 0xA0)
        xact.enqueue(5, 0xA1)
        xact.enqueue(5, 0xA2)
        xact.enqueue(5, 0xA3)
        xact.idle(6)

        for i in 0 .. 3
            let v4 = xact.dequeue(5)
            let expect4 = 0xA0 + i
            assert v4 == expect4
                else fail("Test 4: dequeue(q=5)[${i}]=0x${v4:08x}, expected 0x${expect4:08x}")
            xact.idle(2)
        end for
        log(info, "Test 4 PASS: FIFO order on queue 5 (4 items)")

        // ── Test 5: Back-to-back enqueue same queue ───────────
        // valid held high across 3 cycles with changing data. The
        // 3-cycle valid-held sequence runs inside the transactor so
        // `wait 1 cycle` lowers to a synchronous `tick()` (see
        // method-level comment for why this matters).
        xact.enqueue_b2b3(10, 0xB0, 0xB1, 0xB2)
        xact.idle(6)

        let v5a = xact.dequeue(10)
        assert v5a == 0xB0
            else fail("Test 5: dequeue(q=10)[0]=0x${v5a:08x}, expected 0x000000B0")
        xact.idle(2)
        let v5b = xact.dequeue(10)
        assert v5b == 0xB1
            else fail("Test 5: dequeue(q=10)[1]=0x${v5b:08x}, expected 0x000000B1")
        xact.idle(2)
        let v5c = xact.dequeue(10)
        assert v5c == 0xB2
            else fail("Test 5: dequeue(q=10)[2]=0x${v5c:08x}, expected 0x000000B2")
        xact.idle(4)
        log(info, "Test 5 PASS: back-to-back enqueue queue 10 (3 cycles)")

        // ── Test 6: Simultaneous enqueue + dequeue (diff queues) ─
        xact.enqueue(20, 0xC0)
        xact.idle(6)

        // Same-cycle enqueue(q=21, 0xC1) + dequeue(q=20). Runs in
        // the transactor for the same wait-1-cycle reason as Test 5.
        xact.enqueue_dequeue_simul(21, 0xC1, 20)

        assert dut.dequeue_resp_valid == 1
            else fail("Test 6: simul deq resp_valid=${dut.dequeue_resp_valid}, expected 1")
        assert dut.dequeue_data == 0xC0
            else fail("Test 6: simul deq(q=20)=0x${dut.dequeue_data:08x}, expected 0x000000C0")
        xact.idle(6)

        let v6 = xact.dequeue(21)
        assert v6 == 0xC1
            else fail("Test 6: dequeue(q=21) after simul=0x${v6:08x}, expected 0x000000C1")
        log(info, "Test 6 PASS: simultaneous enqueue(q=21) + dequeue(q=20)")

        // ── Test 7: High queue numbers — stress 256-queue array ─
        xact.enqueue(255, 0xFF00)
        xact.enqueue(128, 0x8000)
        xact.idle(6)

        let v7a = xact.dequeue(255)
        assert v7a == 0xFF00
            else fail("Test 7: dequeue(q=255)=0x${v7a:08x}, expected 0x0000FF00")
        xact.idle(2)
        let v7b = xact.dequeue(128)
        assert v7b == 0x8000
            else fail("Test 7: dequeue(q=128)=0x${v7b:08x}, expected 0x00008000")
        log(info, "Test 7 PASS: high queue numbers (q=255, q=128)")

        log(info, "ALL 7 SUB-TESTS PASSED — BufMgr 256-queue buffer manager coverage")
    end run
end impl BufMgrTest

