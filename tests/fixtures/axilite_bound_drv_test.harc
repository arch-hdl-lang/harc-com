// AxiLiteRegs test demonstrating `bound to BusType` on a driver
// running as an independent coroutine actor (Phase 2b of the
// bus-typing rollout).
//
// The driver declares `bound to BusAxiLite`; instantiation pairs
// with `let drv : AxilDrv = bind axil`. At codegen, the driver gets:
//   - a per-instance `std::deque<RegOp>` transaction queue
//   - its own `harc_rt::ThreadSlot` registered with the scheduler
//   - a coroutine that loops:
//       co_await wait_until(!queue.empty());
//       pop t;
//       <on req(t) body — bus.<ch>.send/recv lower to co_await>
//
// `emit drv.req(t)` from the run coroutine just enqueues the
// transaction (non-blocking). The driver coroutine processes
// transactions in parallel with the run coroutine — they're both
// scheduled by `harc_rt::ThreadScheduler` from the same OS thread
// (Phase 3 will add OS-thread parallelism on top of the same actor
// model).
//
// Compared to Phase 2a's sync model: the run coroutine no longer
// blocks for ~7 cycles per dispatch waiting for the bus dance to
// finish. It queues all 5 transactions in 0 cycles; verification
// then waits for the queue to drain.

use BusAxiLite

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction RegOp

driver AxilDrv bound to BusAxiLite
    req       : in event<RegOp>
    last_read : uint<32> default 0

    on req(t)
        // Write phase. `bus.aw.send(addr, prot)` would be the typed
        // form once the elaborated DUT exposes `prot`; our test DUT
        // was elaborated without it, so the `aw` channel is driven
        // signal-by-signal. `bus.w.send` works fine because the W
        // channel's payload (data, strb) is fully on the DUT.
        bus.aw.addr = t.addr
        bus.aw.valid = 1
        bus.w.send(t.value, 15)        // data, strb
        bus.aw.valid = 0
        wait 2 cycles

        // Read phase. `bus.ar.send(addr, prot)` blocked by the same
        // missing-`prot` issue; otherwise the AR drive is identical
        // to the manual form.
        bus.ar.addr = t.addr
        bus.ar.valid = 1
        let val = bus.r.recv()         // auto-handshake on R, capture data
        bus.ar.valid = 0
        wait 1 cycle
        last_read = val
    end on
end driver AxilDrv

scoreboard AxilSb
    expected : queue<uint<32>>
    errors   : uint<32> default 0
end scoreboard AxilSb

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test AxiLiteBoundDrvTest
    let dut  : AxiLiteRegs
    let axil : BusAxiLite = bind dut
    let drv  : AxilDrv    = bind axil
    let sb   : AxilSb

    scope sim
        run
            log(info, "AxiLiteRegs `bound to BusAxiLite` driver test")

            // Reset.
            dut.rst = 1
            axil.aw.valid = 0
            axil.w.valid = 0
            axil.b.ready = 1
            axil.ar.valid = 0
            axil.r.ready = 1
            dut.mm2s_done = 0
            dut.mm2s_halted = 1
            dut.mm2s_idle = 1
            dut.s2mm_done = 0
            dut.s2mm_halted = 1
            dut.s2mm_idle = 1
            dut.mm2s_sg_done = 0
            dut.s2mm_sg_done = 0
            dut.mm2s_sg_active = 0
            dut.s2mm_sg_active = 0
            wait 2 cycles
            dut.rst = 0
            wait 1 cycle

            // Drive 5 random write/read pairs through the bound
            // driver by emitting on its `req` event. Each emit
            // queues a transaction non-blockingly; the driver
            // coroutine pulls them off and runs the bus dance in
            // parallel with the run coroutine.
            let txns = RandomTxns(5)
            for t in txns
                emit drv.req(t)
            end for

            // Wait long enough for the driver to process all 5
            // transactions. Each round-trip is ~7 cycles (write
            // dance ~3, gap 2, read dance ~2). Some slack on top
            // for safety.
            wait 50 cycles

            // After the queue drains, the driver's `last_read` holds
            // the result of the FINAL read. Push the final expected
            // value to the scoreboard for comparison — the most we
            // can check without per-transaction history (a monitor
            // coroutine pushing each completed read into the
            // scoreboard would catch every value, but that's Phase 2c).
            let final_idx = 4
            for t in txns
                if final_idx == 0
                    sb.expected.push(t.value)
                end if
                final_idx = final_idx - 1
            end for
            let exp = sb.expected.pop()
            assert drv.last_read == exp
                else fail("driver final read=0x${drv.last_read:08x}, expected 0x${exp:08x}")

            log(info, "PASS: 5 transactions processed by `bound to BusAxiLite` actor coroutine")
        end run
    end scope sim
end test AxiLiteBoundDrvTest
