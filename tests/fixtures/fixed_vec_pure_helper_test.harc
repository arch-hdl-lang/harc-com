function echo_vec(values: Vec<uint<8>, 2>) -> Vec<uint<8>, 2>
    return values
end function echo_vec

function vec_matches(values: Vec<uint<8>, 2>, expected: Vec<uint<8>, 2>) -> bool
    return values == expected
end function vec_matches

function echo_grid(values: Vec<Vec<uint<8>, 2>, 2>) -> Vec<Vec<uint<8>, 2>, 2>
    return values
end function echo_grid

function grid_matches(values: Vec<Vec<uint<8>, 2>, 2>, expected: Vec<Vec<uint<8>, 2>, 2>) -> bool
    return values == expected
end function grid_matches

function pass_vec(values: Vec<uint<8>, 2>) -> Vec<uint<8>, 2>
    return echo_vec(values)
end function pass_vec

testbench FixedVecPureHelperTb
    dut : Top
    values : Vec<uint<8>, 2>
    expected : Vec<uint<8>, 2>
    grid : Vec<Vec<uint<8>, 2>, 2>
    expected_grid : Vec<Vec<uint<8>, 2>, 2>
end testbench FixedVecPureHelperTb

impl FixedVecPureHelperTest for FixedVecPureHelperTb
    run
        values[0] = 3
        values[1] = 7
        expected[0] = 3
        expected[1] = 7
        let echoed = echo_vec(values)
        assert vec_matches(echoed, expected) else fail("fixed-vector pure-helper ABI changed")
        assert vec_matches(echo_vec(values), expected)
            else fail("composed fixed-vector helper argument changed")
        let passed = pass_vec(values)
        assert vec_matches(passed, expected)
            else fail("composed fixed-vector helper return changed")
        grid[0][0] = 1
        grid[0][1] = 2
        grid[1][0] = 3
        grid[1][1] = 4
        expected_grid[0][0] = 1
        expected_grid[0][1] = 2
        expected_grid[1][0] = 3
        expected_grid[1][1] = 4
        let echoed_grid = echo_grid(grid)
        assert grid_matches(echoed_grid, expected_grid)
            else fail("nested fixed-vector pure-helper ABI changed")
        wait 1 cycle
    end run
end impl FixedVecPureHelperTest
