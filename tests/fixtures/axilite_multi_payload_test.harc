// Multi-payload transactor exercising:
//   - active: `let beat = bus.r.recv()` returning the full payload
//     struct (`beat.data`, `beat.resp`)
//   - passive: `on bus.r.handshake(beat)` capturing the full
//     payload struct on the observation side
//
// Replaces the legacy `driver AxilDrv bound to BusAxiLite` +
// `monitor AxilMon bound to BusAxiLite` split. One transactor with
// both halves; two instances at the test scope (active + passive).

use BusAxiLite

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
end transaction RegOp

scoreboard AxilSb
    r_data : queue<uint<32>>
    r_resp : queue<uint<32>>
end scoreboard AxilSb

transactor AxilXactor bound to BusAxiLite
    sb        : AxilSb
    last_data : uint<32> default 0
    last_resp : uint<32> default 99   // sentinel: 99 = "not yet observed"

    // Always-on multi-payload observation. `beat.data` and
    // `beat.resp` resolve through the channel's full payload
    // struct.
    on bus.r.handshake(beat)
        sb.r_data.push(beat.data)
        sb.r_resp.push(beat.resp)
    end on

    when active
        req : in event<RegOp>

        on req(t)
            bus.aw.addr = t.addr
            bus.aw.valid = 1
            bus.w.send(t.value, 15)
            bus.aw.valid = 0
            wait 2 cycles
            bus.ar.addr = t.addr
            bus.ar.valid = 1

            // recv() returns the full payload struct. `.data` and
            // `.resp` are both available; legacy scalar use still
            // works via the implicit-conversion operator.
            let beat = bus.r.recv()
            bus.ar.valid = 0
            wait 1 cycle
            last_data = beat.data
            last_resp = beat.resp
        end on
    end when
end transactor AxilXactor

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test AxiLiteMultiPayloadTest
    let dut  : AxiLiteRegs
    let axil : BusAxiLite = bind dut
    let drv  : AxilXactor active  = bind axil
    let mon  : AxilXactor passive = bind axil
end test AxiLiteMultiPayloadTest

impl sim for AxiLiteMultiPayloadTest
    run
        log(info, "AxiLiteRegs multi-payload transactor test")

        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        let txns = RandomTxns(5)
        for t in txns
            emit drv.req(t)
        end for
        wait 60 cycles

        // Active populated last_data and last_resp from the
        // FINAL round-trip. AxiLiteRegs returns OKAY (resp=0)
        // for valid register-bank reads.
        assert drv.last_resp == 0
            else fail("expected OKAY (resp=0) on final read, got resp=${drv.last_resp}")

        // Passive pushed (data, resp) for each of 5 reads.
        assert mon.sb.r_data.size() == 5
            else fail("expected 5 r_data observations, got ${mon.sb.r_data.size()}")
        assert mon.sb.r_resp.size() == 5
            else fail("expected 5 r_resp observations, got ${mon.sb.r_resp.size()}")

        // Drain the resp queue; every entry should be 0 (OKAY).
        for _ in 0 .. 5
            let r = mon.sb.r_resp.pop()
            assert r == 0
                else fail("passive observer saw non-OKAY resp: ${r}")
        end for

        log(info, "PASS: multi-payload recv() + handshake() captured data + resp on 5 round-trips")
    end run
end impl AxiLiteMultiPayloadTest

