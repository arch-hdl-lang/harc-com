// HARC TB for arch-com/examples/clk_div_counter.arch — counter clocked
// by an internally divided clock. One external `clk`; the divided clock
// lives inside the module. Active-low async reset.
//
// Inspired by arch-com/examples/clk_div_counter_tb.cpp, but the original
// C++ TB assumed an eval ordering that arch's cpp model provides but real
// Verilator does not (the very first fast edge after `rst_n=1` already
// toggles the divider, so `count==1` immediately after a single settle
// cycle). Numbers below match the actual Verilator-compiled SV.

domain ClkDomain
  freq_mhz: 100
end domain ClkDomain

testbench ClkDivCounterTb
    dut : ClkDivCounter
end testbench ClkDivCounterTb

impl ClkDivCounterTest for ClkDivCounterTb
    clock clk = ClkDomain        // 100 MHz → 10 ns period

    run
        // Active-low reset: hold rst_n=0 for 3 full cycles.
        dut.rst_n = 0
        wait 3 cycles
        dut.rst_n = 1

        // Settle one cycle. The first fast posedge after rst_n=1
        // toggles the divider (clk_slow rises 0→1) and the counter
        // increments to 1.
        wait 1 cycle
        assert dut.count == 1
            else fail("count=${dut.count} after reset+settle, expected 1")
        log(info, "PASS: count=1 after reset+settle (first div_clk rising edge already fired)")

        // After N more fast cycles the counter is at (N+2)/2 with
        // integer division — odd N holds, even N increments.
        for i in 1 .. 8
            wait 1 cycle
            let expected = (i + 2) / 2
            assert dut.count == expected
                else fail("after cycle ${i}: count=${dut.count} expected=${expected}")
        end for
        log(info, "PASS: counter tracks div_clk rising edges over 8 fast cycles")
    end run
end impl ClkDivCounterTest

