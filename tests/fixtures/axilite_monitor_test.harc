// Monitor-based scoreboard. The MONITOR watches the AXI-Lite handshake
// signals every cycle and emits an event when a write/read beat completes;
// the SCOREBOARD subscribes to those events. The test body becomes pure
// stimulus — no manual `emit` from the producer side.
//
// Spec §8.3: monitors are bound to a bus and observe handshake events.
// In v0 we don't have bus protocol types, so the monitor watches raw
// `dut.<signal>` values directly.

transaction RegOp
    addr  : uint<8>
    value : uint<32>
end transaction RegOp

monitor AxiLiteMon
    write_seen  : out event<uint<32>>
    read_seen   : out event<uint<32>>
    rst_release : out event<uint<32>>

    // Default edge mode is rising. AXI-Lite write handshake fires once
    // per beat. `${dut.x}` interpolation now routes through emit_expr so
    // pointer-deref rewrites apply (`dut->x` instead of `dut.x`).
    on dut.axil_w_valid && dut.axil_w_ready
        logf("monitor.log", debug, "WR seen: data=0x${dut.axil_w_data:08x}")
        emit write_seen(dut.axil_w_data)
    end on

    on dut.axil_r_valid && dut.axil_r_ready
        logf("monitor.log", debug, "RD seen: data=0x${dut.axil_r_data:08x}")
        emit read_seen(dut.axil_r_data)
    end on

    // Falling-edge demo — explicit `falling` overrides the rising default.
    // Fires once when reset is deasserted (1→0).
    on dut.rst falling
        logf("monitor.log", info, "reset released")
        emit rst_release(0)
    end on
end monitor AxiLiteMon

scoreboard MonSb
    expected : queue<uint<32>>
    pairs    : uint<32> default 0
    resets   : uint<32> default 0   // counts reset-release events
end scoreboard MonSb

test AxiLiteMonTest
    let dut : AxiLiteRegs
end test AxiLiteMonTest
