// RAL Phase 1b smoke test (docs/ral-support.md §3.1).
//
// Demonstrates field-level decomposition inside `register` blocks.
// A `regblock` declares a register with named bit fields; field-level
// reads/writes lower to masked read-modify-write on the mirror +
// full-register bus traffic via the helper transactor.
//
// Surface exercised:
//   - `register N @ A ... field <name> : <ty> @ <bit_pos> ... end register`
//   - 1-bit fields (`field RS : bit @ 0`)
//   - multi-bit fields (`field MODE : uint<3> @ 4`)
//   - Field-level write: `regs.REG.FIELD = expr` (masked mirror
//     update + full-register bus write)
//   - Field-level read: `regs.REG.FIELD` rvalue (full-register bus
//     read + bit extract)
//   - Coexistence with single-line register form (DMASR_ALL has no
//     fields)

use BusAxiLite

transactor AxilHelper bound to BusAxiLite
    when active
        hookable write(addr: uint<8>, data: uint<32>)
            bus.aw.addr = addr
            bus.aw.valid = 1
            bus.w.send(data, 15)
            bus.aw.valid = 0
            wait 1 cycle
        end write

        hookable read(addr: uint<8>) -> uint<32>
            bus.ar.addr = addr
            bus.ar.valid = 1
            let r = bus.r.recv()
            bus.ar.valid = 0
            wait 1 cycle
            return r.data
        end read
    end when
end transactor AxilHelper

regblock DmaRegs via AxilHelper width 32
    /// DMACR — DMA control register. RS at bit 0 is the run/stop
    /// flag; MODE at bits [6:4] selects the DMA mode.
    register DMACR @ 0x00 access rw
        field RS   : bit     @ 0  reset 0  access rw
        field MODE : uint<3> @ 4  reset 0  access rw
    end register DMACR

    /// MM2S_SA — full-word source address; no field decomposition.
    register MM2S_SA @ 0x18 access rw
end regblock DmaRegs

test RegblockFieldsTest
    let dut    : AxiLiteRegs
    let axil   : BusAxiLite = bind dut
    let helper : AxilHelper active = bind axil
    let regs   : DmaRegs = bind helper

    run
        // Reset.
        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // 1-bit field write: set DMACR.RS.
        regs.DMACR.RS = 1
        assert regs.DMACR.RS == 1
            else fail("DMACR.RS readback (got ${regs.DMACR.RS})")
        // DMACR.MODE is untouched after the write.
        assert regs.DMACR.MODE == 0
            else fail("DMACR.MODE was clobbered by RS write (got ${regs.DMACR.MODE})")

        // Multi-bit field write: set MODE = 0b101.
        regs.DMACR.MODE = 5
        assert regs.DMACR.MODE == 5
            else fail("DMACR.MODE readback (got ${regs.DMACR.MODE})")
        // RS is preserved across the MODE write.
        assert regs.DMACR.RS == 1
            else fail("DMACR.RS clobbered by MODE write (got ${regs.DMACR.RS})")

        // Field-level coexistence with whole-register access.
        regs.MM2S_SA = 3735879680            // 0xDEAD_1000
        assert regs.MM2S_SA == 3735879680
            else fail("MM2S_SA readback (got 0x${regs.MM2S_SA:08x})")

        log(info, "PASS: field-level R/W on DMACR + register-level R/W on MM2S_SA")
    end run
end test RegblockFieldsTest
