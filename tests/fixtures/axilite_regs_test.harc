// AxiLiteRegs test base — DUT lives in arch-com/tests/axi_dma/AxiLiteRegs.arch
// (PG021 register map). Per-backend scopes split via `extend AxiLiteRegsTest`.
//
// `=` is blocking assignment (matches ARCH); used for raw DUT signal drives
// and locals. `<-` is reserved for channel/event/state sends per spec §17.2.
// `wait N cycles` is the single-statement suspend.

function axil_write(dut: AxiLiteRegs, addr: uint<8>, data: uint<32>)
    dut.axil_aw_addr = addr
    dut.axil_aw_valid = 1
    dut.axil_w_data = data
    dut.axil_w_strb = 15
    dut.axil_w_valid = 1
    wait 10 cycles
    dut.axil_aw_valid = 0
    dut.axil_w_valid = 0
    wait 2 cycles
end function axil_write

function axil_read(dut: AxiLiteRegs, addr: uint<8>) -> uint<32>
    let val = 0
    let saw = 0    // single-shot capture flag (no `break` in v0)
    dut.axil_ar_addr = addr
    dut.axil_ar_valid = 1
    // Walk a fixed-cycle budget; on the first observed r_valid, capture
    // the data and immediately deassert AR so the slave doesn't see a
    // sustained AR-valid and start a NEW transaction next cycle.
    for _ in 0 .. 10
        wait 1 cycle
        if dut.axil_r_valid
            if saw == 0
                val = dut.axil_r_data
                dut.axil_ar_valid = 0
                saw = 1
            end if
        end if
    end for
    dut.axil_ar_valid = 0
    wait 1 cycle
    return val
end function axil_read

testbench AxiLiteRegsTb
    dut : AxiLiteRegs
end testbench AxiLiteRegsTb

impl AxiLiteRegsTest for AxiLiteRegsTb
    run
        log(info, "starting AxiLiteRegs test")

        // ── Reset ─────────────────────────────────────────────────────
        log(debug, "asserting reset")
        dut.rst = 1
        dut.axil_aw_addr = 0
        dut.axil_aw_valid = 0
        dut.axil_w_data = 0
        dut.axil_w_strb = 15
        dut.axil_w_valid = 0
        dut.axil_b_ready = 1
        dut.axil_ar_addr = 0
        dut.axil_ar_valid = 0
        dut.axil_r_ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle
        log(debug, "reset deasserted")

        // ── Set MM2S_DMACR.RS ─────────────────────────────────────────
        // logf streams the AXI master traffic to its own file.
        logf("axi_master.log", info, "AW addr=0x${0:08x} data=0x${1:08x}")
        axil_write(dut, 0, 1)
        let dmacr = axil_read(dut, 0)
        logf("axi_master.log", info, "AR addr=0x${0:08x} -> data=0x${dmacr:08x}")
        log(debug, "DMACR readback = ${dmacr} (decimal), 0x${dmacr:x} (hex)")
        assert (dmacr & 1) == 1 else fail("MM2S_DMACR.RS readback got ${dmacr}, want bit0=1")

        // ── Set MM2S_SA, read it back ─────────────────────────────────
        logf("axi_master.log", info, "AW addr=0x${24:08x} data=0x${4096:08x}")
        axil_write(dut, 24, 4096)
        let sa = axil_read(dut, 24)
        logf("axi_master.log", info, "AR addr=0x${24:08x} -> data=0x${sa:08x}")
        assert sa == 4096 else fail("MM2S_SA readback got 0x${sa:08x}, want 0x00001000")

        // ── Set MM2S_LENGTH, read it back ─────────────────────────────
        logf("axi_master.log", info, "AW addr=0x${40:08x} data=0x${16:08x}")
        axil_write(dut, 40, 16)
        let len = axil_read(dut, 40)
        logf("axi_master.log", info, "AR addr=0x${40:08x} -> data=0x${len:08x}")
        assert len == 16 else fail("MM2S_LENGTH readback got ${len}, want 16")

        // ── Negative test (warn): unmapped offset ─────────────────────
        let unmapped = axil_read(dut, 200)
        if unmapped != 0
            logf("axi_master.log", warn, "unmapped read returned 0x${unmapped:08x}")
        end if

        log(info, "all 3 register R/W operations passed")
    end run
end impl AxiLiteRegsTest

// Sim scope of AxiLiteRegsTest — minimal AXI4-Lite write+read on MM2S_DMACR.
// Mirrors `test_mm2s_register_rw` from arch-com/tests/axi_dma/tb_axilite_regs.cpp.
// Exercises the log feature:
//   - severities: info / debug / warn
//   - ${expr:fmt} string interpolation (decimal / hex / zero-padded hex)
//   - logf("path.log", ...) per-file streams. Relative paths are anchored
//     to HARC_LOG_DIR (set by `harc sim` to the build outdir), so the files
//     land next to sim.log.

