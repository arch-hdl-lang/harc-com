// AxiLiteRegs test using a `bus` type for protocol-typed signal
// access (Scope A of the bus-typing rollout — inline bus decl, no
// extern import yet). The DUT's flat AXI-Lite ports are accessed
// through the bus binding `axil`, which gives type-checked field
// names: typo `axil.aw_addrr` becomes a compile error instead of a
// silent C++ build failure.
//
// Bus decl mirrors arch-com/stdlib/BusAxiLite.arch but inlined here
// for v0 simplicity. Extern `use BusAxiLite;` from arch-com/stdlib
// is a follow-up.

bus AxiLiteBus
    handshake_channel aw: send kind: valid_ready
        addr: uint<8>
    end handshake_channel aw

    handshake_channel w: send kind: valid_ready
        data: uint<32>
        strb: uint<4>
    end handshake_channel w

    handshake_channel b: receive kind: valid_ready
        resp: uint<2>
    end handshake_channel b

    handshake_channel ar: send kind: valid_ready
        addr: uint<8>
    end handshake_channel ar

    handshake_channel r: receive kind: valid_ready
        data: uint<32>
        resp: uint<2>
    end handshake_channel r
end bus AxiLiteBus

test AxiLiteBusTest
    let dut : AxiLiteRegs

    // Bus binding: `axil` becomes a type-checked alias for the AXI-
    // Lite signal group on `dut`. The binding name is the prefix —
    // `axil.aw.addr` lowers to `dut->axil_aw_addr`.
    let axil : AxiLiteBus = bind dut

    run
        // Reset.
        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Write 0xCAFEBABE to MM2S_SA (offset 0x18). All access
        // goes through `axil.<channel>.<signal>` rather than
        // `dut.axil_<channel>_<signal>` — the bus type catches
        // typos at compile time.
        axil.aw.addr = 24
        axil.aw.valid = 1
        axil.w.data = 3405691582
        axil.w.strb = 15
        axil.w.valid = 1
        wait 10 cycles
        axil.aw.valid = 0
        axil.w.valid = 0
        wait 2 cycles

        // Read back through the AR/R channels.
        let val = 0
        let saw = 0
        axil.ar.addr = 24
        axil.ar.valid = 1
        for _ in 0 .. 10
            wait 1 cycle
            if axil.r.valid
                if saw == 0
                    val = axil.r.data
                    axil.ar.valid = 0
                    saw = 1
                end if
            end if
        end for
        axil.ar.valid = 0
        wait 1 cycle

        assert val == 3405691582
            else fail("read got 0x${val:08x}, expected 0xCAFEBABE")
        log(info, "PASS: bus-typed AXI-Lite write/read round-trip")
    end run
end test AxiLiteBusTest

