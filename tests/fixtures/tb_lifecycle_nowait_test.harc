// #619 M4b: a reusable testbench whose `setup` AND `check` lifecycle
// bodies are NON-SUSPENDING (pure field writes / asserts / log, no
// `wait`), including `teardown`. Bound by two impls, so under
// HARC_TBIR_NATIVE_LIFECYCLE the
// shared bodies are emitted OUT-OF-LINE once (a real call), not
// re-inlined per test. The v1==tbir trace-diff proves the out-of-line
// parameter passing is equivalence-clean.

testbench CounterNoWaitTb
    dut : Top
    expected : uint<32> default 0
    seen_setup : uint<32> default 0

    // Non-suspending setup: field writes + a testbench-field marker,
    // no `wait`. Runs before every bound test's `run`.
    setup
        dut.rst = 0
        dut.en = 0
        seen_setup = 1
    end setup

    // Non-suspending check: asserts + log, no `wait`. Runs after every
    // bound test's `run`.
    check
        assert seen_setup == 1
            else fail("shared setup did not run")
        assert dut.count_out == expected
            else fail("shared final check: count_out=${dut.count_out}, expected=${expected}")
        log(info, "shared non-suspending check passed")
    end check

    // Non-suspending teardown (Plain variant). This is intentionally a
    // real body rather than an empty phase so ownership tests can prove the
    // teardown definition is emitted once and both impls call it.
    teardown
        assert seen_setup == 1
            else fail("shared setup marker was lost before teardown")
        log(info, "shared non-suspending teardown passed")
    end teardown
end testbench CounterNoWaitTb

impl NoWaitBumpTwo for CounterNoWaitTb
    run
        dut.rst = 1
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle
        dut.en = 1
        wait 2 cycles
        dut.en = 0
        expected = 2
    end run
end impl NoWaitBumpTwo

impl NoWaitBumpFour for CounterNoWaitTb
    run
        dut.rst = 1
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle
        dut.en = 1
        wait 4 cycles
        dut.en = 0
        expected = 4
    end run
end impl NoWaitBumpFour
