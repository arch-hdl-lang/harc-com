// AxiLiteRegs test demonstrating `connect` blocks inside `env`: a
// `connect` edge wires the sequencer's `dispatched` event to the
// transactor's `req` event. Calling `env.sequencer.dispatch(...)`
// indirectly drives the bus through the connect bridge — no
// `emit env.drv.req(...)` from the test scope.
//
// Pattern (mirrors spec §8.1):
//
//   sequencer Seq
//       dispatched : out event<RegOp>
//       hookable dispatch(seq: TSeq<RegOp>)
//           for t in seq emit dispatched(t) end for
//       end run
//   end sequencer Seq
//
//   transactor Drv
//       when active
//           req : in event<RegOp>
//           on req(t) ...drive bus... end on
//       end when
//   end transactor Drv
//
//   env E
//       sequencer : Seq
//       drv       : Drv  active
//       connect
//           sequencer.dispatched -> drv.req
//       end connect
//   end env E

transaction RegOp
    addr  : uint<8>  with [range(0, 64)]
    value : uint<32>
    !mode : uint<8>  default 0
end transaction RegOp

sequencer AxilSeq
    dispatched : out event<RegOp>

    // `run` is a reserved keyword (scope `run` block); the spec
    // shorthand `seq.run(...)` is conceptual — pick any other method
    // name in the lowering. `dispatch` is the obvious one.
    hookable dispatch(txns: TSeq<RegOp>)
        for t in txns
            emit dispatched(t)
        end for
    end dispatch
end sequencer AxilSeq

transactor AxilXactor
    dut       : AxiLiteRegs
    last_read : uint<32> default 0

    when active
        req : in event<RegOp>

        on req(t)
            // Write phase
            dut.axil_aw_addr = t.addr
            dut.axil_aw_valid = 1
            dut.axil_w_data = t.value
            dut.axil_w_strb = 15
            dut.axil_w_valid = 1
            wait 10 cycles
            dut.axil_aw_valid = 0
            dut.axil_w_valid = 0
            wait 2 cycles

            // Read phase
            let val = 0
            let saw = 0
            dut.axil_ar_addr = t.addr
            dut.axil_ar_valid = 1
            for _ in 0 .. 10
                wait 1 cycle
                if dut.axil_r_valid
                    if saw == 0
                        val = dut.axil_r_data
                        dut.axil_ar_valid = 0
                        saw = 1
                    end if
                end if
            end for
            dut.axil_ar_valid = 0
            wait 1 cycle
            last_read = val
        end on
    end when
end transactor AxilXactor

scoreboard AxilSb
    expected : queue<uint<32>>
    errors   : uint<32> default 0
end scoreboard AxilSb

env AxilEnv
    sequencer : AxilSeq
    drv       : AxilXactor active
    sb        : AxilSb

    connect
        sequencer.dispatched -> drv.req
    end connect
end env AxilEnv

tseq RandomTxns(n: int) -> TSeq<RegOp>
    for _ in 0 .. n
        let t : RegOp
        randomize(t)
        t.addr = 24
        yield t
    end for
end tseq RandomTxns

test AxiLiteConnectTest
    let dut : AxiLiteRegs
    let env : AxilEnv

    scope sim
        run
            log(info, "AxiLiteRegs env+connect test (sequencer→transactor via event bridge)")
            env.drv.dut = dut

            // Reset.
            dut.rst = 1
            dut.axil_aw_addr = 0
            dut.axil_aw_valid = 0
            dut.axil_w_data = 0
            dut.axil_w_strb = 15
            dut.axil_w_valid = 0
            dut.axil_b_ready = 1
            dut.axil_ar_addr = 0
            dut.axil_ar_valid = 0
            dut.axil_r_ready = 1
            dut.mm2s_done = 0
            dut.mm2s_halted = 1
            dut.mm2s_idle = 1
            dut.s2mm_done = 0
            dut.s2mm_halted = 1
            dut.s2mm_idle = 1
            dut.mm2s_sg_done = 0
            dut.s2mm_sg_done = 0
            dut.mm2s_sg_active = 0
            dut.s2mm_sg_active = 0
            wait 2 cycles
            dut.rst = 0
            wait 1 cycle

            // Pre-seed expected values into the scoreboard, then let the
            // sequencer dispatch each transaction. The connect bridge
            // forwards every emit on env.sequencer.dispatched into the
            // transactor's req event, which fires the active driver
            // body. After the run, walk the queue and assert each
            // round-trip matched.
            let txns = RandomTxns(5)
            for t in txns
                env.sb.expected.push(t.value)
            end for

            env.sequencer.dispatch(txns)

            for t in txns
                let exp = env.sb.expected.pop()
                if env.drv.last_read != exp
                    env.sb.errors = env.sb.errors + 1
                end if
            end for
            assert env.sb.errors > 0 || env.sb.expected.empty()
                else fail("scoreboard not drained")

            log(info, "PASS: 5 sequencer→transactor round-trips via `connect` event bridge")
        end run
    end scope sim
end test AxiLiteConnectTest
