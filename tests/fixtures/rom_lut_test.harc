// HARC TB for arch-com/examples/rom_lut.arch — an 8-entry, 8-bit ROM
// pre-initialised to a sine approximation. Each read takes 1 cycle.
//
// Compare with arch-com/examples/rom_lut_tb.cpp (~50 lines of hand
// C++): the HARC version is the same shape but ~25 lines, with a
// helper function and a covergroup for free.

function read_addr(dut: RomLut, addr: uint<3>) -> uint<8>
    dut.rd_addr = addr
    dut.rd_en = 1
    wait 1 cycle
    return dut.rd_data
end function read_addr

// Coverage: did we hit every address?
covergroup RomCov @(posedge dut.clk)
    cp_addr : cover dut.rd_addr
        bins
            a0 = {0}
            a1 = {1}
            a2 = {2}
            a3 = {3}
            a4 = {4}
            a5 = {5}
            a6 = {6}
            a7 = {7}
        end bins
end covergroup RomCov

testbench RomLutTb
    dut : RomLut
    cov : RomCov
end testbench RomLutTb

impl RomLutTest for RomLutTb
    run
        // Init inputs.
        dut.rd_addr = 0
        dut.rd_en = 0
        wait 1 cycle

        // Sweep all 8 addresses; values come from the inline-init
        // array `[0x00, 0x31, 0x5A, 0x76, 0x7F, 0x76, 0x5A, 0x31]`.
        assert read_addr(dut, 0) == 0   else fail("addr 0: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 1) == 49  else fail("addr 1: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 2) == 90  else fail("addr 2: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 3) == 118 else fail("addr 3: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 4) == 127 else fail("addr 4: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 5) == 118 else fail("addr 5: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 6) == 90  else fail("addr 6: got 0x${dut.rd_data:02x}")
        assert read_addr(dut, 7) == 49  else fail("addr 7: got 0x${dut.rd_data:02x}")

        log(info, "PASS: 8 ROM entries match the inline-init pattern")
    end run

    check
        cov.report()
        assert cov.cp_addr.a0 > 0 else fail("addr 0 coverage hole")
        assert cov.cp_addr.a7 > 0 else fail("addr 7 coverage hole")
    end check
end impl RomLutTest

