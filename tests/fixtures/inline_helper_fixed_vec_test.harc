function echo_vec(dut: Top, values: Vec<uint<8>, 2>) -> Vec<uint<8>, 2>
    let observed = dut.count_out
    return values
end function echo_vec

function echo_grid(dut: Top, values: Vec<Vec<uint<8>, 2>, 2>) -> Vec<Vec<uint<8>, 2>, 2>
    let observed = dut.count_out
    return values
end function echo_grid

function vec_matches(values: Vec<uint<8>, 2>, expected: Vec<uint<8>, 2>) -> bool
    return values == expected
end function vec_matches

function grid_matches(values: Vec<Vec<uint<8>, 2>, 2>, expected: Vec<Vec<uint<8>, 2>, 2>) -> bool
    return values == expected
end function grid_matches

testbench InlineHelperFixedVecTb
    dut : Top
    values : Vec<uint<8>, 2>
    expected : Vec<uint<8>, 2>
    grid : Vec<Vec<uint<8>, 2>, 2>
    expected_grid : Vec<Vec<uint<8>, 2>, 2>
end testbench InlineHelperFixedVecTb

impl InlineHelperFixedVecTest for InlineHelperFixedVecTb
    run
        values[0] = 3
        values[1] = 7
        expected[0] = 3
        expected[1] = 7
        let echoed = echo_vec(dut, values)
        assert vec_matches(echoed, expected)
            else fail("fixed-vector inlined-helper ABI changed")

        grid[0][0] = 1
        grid[0][1] = 2
        grid[1][0] = 3
        grid[1][1] = 4
        expected_grid[0][0] = 1
        expected_grid[0][1] = 2
        expected_grid[1][0] = 3
        expected_grid[1][1] = 4
        let echoed_grid = (echo_grid(dut, grid))
        assert grid_matches(echoed_grid, expected_grid)
            else fail("nested fixed-vector inlined-helper ABI changed")
        wait 1 cycle
    end run
end impl InlineHelperFixedVecTest
