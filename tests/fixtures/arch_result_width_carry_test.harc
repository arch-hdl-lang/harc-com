        assert r_mul_ab_s129[257:256] == 0x0 else fail("r_mul_ab_s129[257:256]")
        assert r_mul_ca_s129[31:0] == 0x0 else fail("r_mul_ca_s129[31:0]")
        assert r_mul_ca_s129[63:32] == 0x0 else fail("r_mul_ca_s129[63:32]")
        assert r_mul_ca_s129[95:64] == 0x0 else fail("r_mul_ca_s129[95:64]")
        assert r_mul_ca_s129[127:96] == 0x0 else fail("r_mul_ca_s129[127:96]")
        assert r_mul_ca_s129[159:128] == 0x1 else fail("r_mul_ca_s129[159:128]")
        assert r_mul_ca_s129[191:160] == 0x0 else fail("r_mul_ca_s129[191:160]")
        assert r_mul_ca_s129[223:192] == 0x0 else fail("r_mul_ca_s129[223:192]")
        assert r_mul_ca_s129[255:224] == 0x0 else fail("r_mul_ca_s129[255:224]")
        assert r_mul_ca_s129[257:256] == 0x3 else fail("r_mul_ca_s129[257:256]")
        // An unsigned difference is its result-width pattern, typed or
        // inferred, and a width method sees the widened signed sum.
        let small : uint<8> = 1
        let big : uint<8> = 255
        let d9 : uint<9> = small - big
        assert d9 == 258 else fail("uint<9> difference")
        let du = small - big
        assert du == 258 else fail("inferred uint<9> difference")
        assert (small - big).zext<16>() == 258 else fail("zext of the 9-bit difference")
        let s100 : sint<8> = 100
        let s16 : sint<16> = (s100 + s100).sext<16>()
        assert s16 == 200 else fail("sext of the 9-bit signed sum")
        let p40 : uint<40> = 0xFFFFFFFFFF
        let pq = p40 * p40
        let pq80 : uint<80> = pq
        assert pq80[79:40] == 0xFFFFFFFFFE else fail("inferred uint<80> product high half")
        assert pq80[39:0] == 1 else fail("inferred uint<80> product low half")
        log(info, "PASS: 72 exact ARCH-width results")
    end run
end test ArchResultWidthCarryTest
