        assert r_add_ab_u63[31:0] == 0xfffffffd else fail("r_add_ab_u63[31:0]")
        assert r_add_ab_u63[63:32] == 0xffffffff else fail("r_add_ab_u63[63:32]")
        assert r_add_ca_u63[31:0] == 0x0 else fail("r_add_ca_u63[31:0]")
