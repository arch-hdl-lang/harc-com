// RAL passive record API — `record_write` / `record_read` WITHOUT a
// per-register write callback (docs/ral-support.md §3.2).
//
// Motivating use case (issue #218): a checker that *observes* bus
// traffic and shadows CSR state. Instead of a hand-written address
// `if/elsif` decode ladder, the checker calls:
//
//   regs.record_write(addr, data)   // decode + mirror update, no bus
//   let v = regs.record_read(addr)  // decode + mirror read, no bus
//
// `record_write` / `record_read` are *passive* — they never drive the
// bus (the monitor already saw the transaction). They differ from the
// active frontdoor (`regs.REG = v`), which issues a bus access.
//
// This fixture deliberately registers NO `on regs.REG` callback: the
// per-register write callback lowers (in v1) to a `[&]`-capturing
// closure over run-scope state, fired from inside `record_write`, which
// the function-per-CFG TB-IR cannot express (the same blocker as the
// `axilite_hooks` pre/post method hooks). The callback-bearing corpus
// fixtures (regblock_record_test, regblock_record_recursion_test) stay
// rejected precisely; the passive API on its own is fully lowered, so
// this fixture proves it under BOTH codegens (v1 == tbir, trace-diff
// clean). The record decode + mirror update is pure host state with no
// trace events, so the two backends record identical (empty) record-op
// activity; the only observable signal is the final assert outcomes.

use BusAxiLite

transactor AxilHelper bound to BusAxiLite
    when active
        hookable write(addr: uint<8>, data: uint<32>)
            bus.aw.addr = addr
            bus.aw.valid = 1
            bus.w.send(data, 15)
            bus.aw.valid = 0
            wait 1 cycle
        end write

        hookable read(addr: uint<8>) -> uint<32>
            bus.ar.addr = addr
            bus.ar.valid = 1
            let r = bus.r.recv()
            bus.ar.valid = 0
            wait 1 cycle
            return r.data
        end read
    end when
end transactor AxilHelper

regblock DmaRegs via AxilHelper width 32
    register MM2S_SA   @ 0x18 access rw
    register MM2S_LEN  @ 0x28 access rw
    register S2MM_SA   @ 0x20 access rw
end regblock DmaRegs

agent RuntimeAddressHolder
    values : Vec<uint<8>, 2>
end agent RuntimeAddressHolder

testbench RegblockRecordApiTb
    dut : AxiLiteRegs
    holder : RuntimeAddressHolder
end testbench RegblockRecordApiTb

impl RegblockRecordApiTest for RegblockRecordApiTb
    let axil   : BusAxiLite = bind dut
    let helper : AxilHelper active = bind axil
    let regs   : DmaRegs = bind helper

    run
        dut.rst = 1
        axil.aw.valid = 0
        axil.w.valid = 0
        axil.b.ready = 1
        axil.ar.valid = 0
        axil.r.ready = 1
        dut.mm2s_done = 0
        dut.mm2s_halted = 1
        dut.mm2s_idle = 1
        dut.s2mm_done = 0
        dut.s2mm_halted = 1
        dut.s2mm_idle = 1
        dut.mm2s_sg_done = 0
        dut.s2mm_sg_done = 0
        dut.mm2s_sg_active = 0
        dut.s2mm_sg_active = 0
        wait 2 cycles
        dut.rst = 0
        wait 1 cycle

        // Observe three bus writes passively (e.g. forwarded from a bus
        // monitor). No bus traffic is issued; only the mirror updates.
        // The address decode is owned by the codegen — no `if addr == ...`
        // ladder here.
        regs.record_write(0x18, 305419896)    // 0x12345678 -> MM2S_SA
        let runtime_write_addr = 0x20
        let missing_write_addr = 0x24
        regs.record_write(runtime_write_addr, 64) // -> S2MM_SA
        regs.record_write(missing_write_addr, 999) // unmatched: no mirror changes
        regs.record_write(0x28, 4096)         // -> MM2S_LEN

        // Read the shadow back by address — pure mirror, no bus read.
        let sa  = regs.record_read(0x18)
        let s2  = regs.record_read(0x20)
        let len = regs.record_read(0x28)
        // Runtime decode: a local address must select the same mirror
        // cell, while an unmatched runtime address returns zero.
        let runtime_addr = 0x20
        let missing_addr = 0x24
        let s2_runtime = regs.record_read(runtime_addr)
        let missing_runtime = regs.record_read(missing_addr)

        assert sa == 305419896
            else fail("record_read MM2S_SA (got 0x${sa:08x})")
        assert s2 == 64
            else fail("record_read S2MM_SA (got 0x${s2:08x})")
        assert len == 4096
            else fail("record_read MM2S_LEN (got 0x${len:08x})")
        assert s2_runtime == 64
            else fail("runtime record_read S2MM_SA (got 0x${s2_runtime:08x})")
        assert missing_runtime == 0
            else fail("runtime record_read unmatched address (got 0x${missing_runtime:08x})")

        // A second observed write to an already-shadowed register
        // overwrites the mirror cell (last-writer-wins, masked to the
        // 32-bit register width).
        regs.record_write(0x18, 2882400001)   // 0xABCD_0001 -> MM2S_SA
        let sa2 = regs.record_read(0x18)
        assert sa2 == 2882400001
            else fail("record_read MM2S_SA after overwrite (got 0x${sa2:08x})")

        log(info, "ALL TESTS PASSED - regblock_record_api_test")
    end run
end impl RegblockRecordApiTest
