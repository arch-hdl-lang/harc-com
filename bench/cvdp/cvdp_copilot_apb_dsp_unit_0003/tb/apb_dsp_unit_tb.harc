// HARC testbench for CVDP cid012 `cvdp_copilot_apb_dsp_unit_0003`.
//
// DUT: apb_dsp_unit behind the generated `apb_dsp_unit_top` wrapper.
// APB transactions complete when pselx && penable is sampled on clk.
// CSR map:
//   0 operand_1, 1 operand_2, 2 enable, 3 write_address,
//   4 write_data, 5 result.
//
// Strategy:
//   - reset and idle baseline
//   - directed APB writes/reads across every valid CSR
//   - invalid CSR accesses outside 0x0..0x5
//   - malformed handshakes where pselx or penable is missing
//   - SRAM write-mode loads followed by addition and multiplication
//   - mid-test reset and post-reset resume
//   - constrained-random APB address/data/mode/control sweeps using
//     keep constraints, randomize-with constraints, relation inlining,
//     field range/dist metadata, explicit covergroup crosses, and the
//     transaction auto-coverage hooks emitted by HARC.
//
// Limitation: paddr is only 10 bits, so the RTL branch `paddr > MEM_SIZE`
// under MODE_WRITE compares against 1024 and is structurally unreachable.

transaction ApbStim
    addr : uint<10> with [dist {[0..5] :/ 70, [6..1023] :/ 30}]
    data : uint<8> with [dist {[0..0] :/ 10, [1..254] :/ 70, [255..255] :/ 20}]
    mode : uint<8> with [range(0, 7)]
    write : uint<1>
    sel : uint<1>
    enable : uint<1>

    keep mode in [0..7]
end transaction ApbStim

relation LegalCsr(t: ApbStim) = t.addr in [0..5]
relation InvalidCsr(t: ApbStim) = t.addr > 5
relation ProperApb(t: ApbStim)
    t.sel == 1
    t.enable == 1
end relation ProperApb

covergroup ApbDspCov @(posedge dut.clk)
    cp_addr : cover dut.paddr
        bins
            operand1 = {0}
            operand2 = {1}
            enable = {2}
            write_addr = {3}
            write_data = {4}
            result = {5}
            invalid_low = [6..255]
            invalid_high = [256..1023]
        end bins

    cp_write : cover dut.pwrite
        bins
            read = {0}
            write = {1}
        end bins

    cp_handshake : cover ((dut.pselx << 1) | dut.penable)
        bins
            idle = {0}
            enable_only = {1}
            setup_only = {2}
            active_txn = {3}
        end bins

    cp_mode_data : cover dut.pwdata
        bins
            disabled = {0}
            add = {1}
            mult = {2}
            mem_write = {3}
            invalid_mode = [4..255]
        end bins

    cp_prdata : cover dut.prdata
        bins
            zero = {0}
            low = [1..15]
            mid = [16..254]
            max = {255}
        end bins

    cp_ready : cover dut.pready
        bins
            low = {0}
            high = {1}
        end bins

    cp_error : cover dut.pslverr
        bins
            clear = {0}
            set = {1}
        end bins

    cross cp_addr, cp_write
    cross cp_write, cp_error
    cross cp_handshake, cp_error
end covergroup ApbDspCov

transactor ApbDspBusXactor
    dut : apb_dsp_unit_top

    when active
        hookable idle()
            dut.pselx = 0
            dut.penable = 0
            dut.pwrite = 0
            dut.paddr = 0
            dut.pwdata = 0
            wait 1 cycle
        end idle

        hookable reset_dut()
            dut.presetn = 0
            dut.paddr = 0
            dut.pselx = 0
            dut.penable = 0
            dut.pwrite = 0
            dut.pwdata = 0
            dut.sram_valid = 0
            wait 3 cycles
            assert dut.pready == 0 else fail("reset: pready expected 0")
            assert dut.pslverr == 0 else fail("reset: pslverr expected 0")
            assert dut.prdata == 0 else fail("reset: prdata expected 0")
            dut.presetn = 1
            wait 1 cycle
        end reset_dut

        hookable mid_reset()
            dut.presetn = 0
            wait 2 cycles
            assert dut.pready == 0 else fail("mid-reset: pready expected 0")
            assert dut.pslverr == 0 else fail("mid-reset: pslverr expected 0")
            assert dut.prdata == 0 else fail("mid-reset: prdata expected 0")
            dut.presetn = 1
            wait 1 cycle
        end mid_reset

        hookable write(addr: uint<10>, data: uint<8>)
            dut.paddr = addr
            dut.pwdata = data
            dut.pwrite = 1
            dut.pselx = 1
            dut.penable = 0
            wait 1 cycle
            dut.penable = 1
            wait 1 cycle
            assert dut.pready == 1
                else fail("apb_write addr=0x${addr:03x}: pready was not asserted")
            dut.pselx = 0
            dut.penable = 0
            dut.pwrite = 0
            wait 1 cycle
        end write

        hookable read(addr: uint<10>) -> uint<8>
            dut.paddr = addr
            dut.pwdata = 0
            dut.pwrite = 0
            dut.pselx = 1
            dut.penable = 0
            wait 1 cycle
            dut.penable = 1
            wait 1 cycle
            assert dut.pready == 1
                else fail("apb_read addr=0x${addr:03x}: pready was not asserted")
            let val = dut.prdata
            dut.pselx = 0
            dut.penable = 0
            wait 1 cycle
            return val
        end read

        hookable raw_cycle(addr: uint<10>, data: uint<8>, write_en: uint<1>, sel: uint<1>, enable: uint<1>)
            dut.paddr = addr
            dut.pwdata = data
            dut.pwrite = write_en
            dut.pselx = sel
            dut.penable = enable
            wait 1 cycle
        end raw_cycle

        hookable invalid_access(addr: uint<10>, data: uint<8>, write_en: uint<1>)
            raw_cycle(addr, data, write_en, 1, 0)
            raw_cycle(addr, data, write_en, 1, 1)
            assert dut.pslverr == 1
                else fail("invalid APB addr=0x${addr:03x} did not raise pslverr")
            idle()
        end invalid_access

        hookable store_sram(addr: uint<8>, data: uint<8>)
            write(2, 3)
            write(3, addr)
            write(4, data)
            pulse_sram_valid()
        end store_sram

        hookable pulse_sram_valid()
            dut.sram_valid = 0
            wait 1 cycle
            dut.sram_valid = 1
            wait 1 cycle
            dut.sram_valid = 0
            wait 1 cycle
        end pulse_sram_valid
    end when
end transactor ApbDspBusXactor

testbench ApbDspTb
    dut : apb_dsp_unit_top
    cov : ApbDspCov
    bus : ApbDspBusXactor active
end testbench ApbDspTb

impl ApbDspTest for ApbDspTb
    run
        log(info, "apb_dsp_unit: APB CSR, SRAM, arithmetic, constraints, and coverage")

        bus.dut = dut
        bus.reset_dut()

        bus.write(0, 0x00)
        bus.write(1, 0xFF)
        bus.write(2, 0x00)
        bus.write(3, 0x55)
        bus.write(4, 0xAA)
        assert bus.read(0) == 0x00 else fail("CSR0 readback mismatch")
        assert bus.read(1) == 0xFF else fail("CSR1 readback mismatch")
        assert bus.read(2) == 0x00 else fail("CSR2 readback mismatch")
        assert bus.read(3) == 0x55 else fail("CSR3 readback mismatch")
        assert bus.read(4) == 0xAA else fail("CSR4 readback mismatch")

        bus.write(0, 0xFF)
        bus.write(1, 0x00)
        bus.write(2, 0x07)
        bus.write(3, 0x00)
        bus.write(4, 0xFF)
        assert bus.read(2) == 0x07 else fail("invalid mode CSR readback mismatch")

        bus.raw_cycle(0, 0x33, 1, 1, 0)
        bus.raw_cycle(0, 0x33, 1, 0, 1)
        bus.raw_cycle(0, 0x33, 1, 0, 0)
        assert bus.read(0) == 0xFF
            else fail("malformed handshake unexpectedly changed operand_1")

        bus.write(2, 0)
        bus.raw_cycle(0x3FF, 0, 0, 1, 0)
        bus.raw_cycle(0x3FF, 0, 0, 1, 1)
        assert dut.pslverr == 1
            else fail("invalid CSR read did not raise pslverr")
        bus.raw_cycle(0x3FF, 0, 0, 0, 0)
        assert dut.pslverr == 0
            else fail("pslverr did not clear after invalid CSR access")

        bus.invalid_access(0x200, 0x44, 1)

        bus.store_sram(0x10, 0x12)
        bus.store_sram(0x11, 0x34)
        bus.store_sram(0xFE, 0xFF)
        bus.write(2, 3)
        assert bus.read(0x10) == 0x12
            else fail("memory read @0x10 mismatch in write mode")
        assert bus.read(0x11) == 0x34
            else fail("memory read @0x11 mismatch in write mode")

        bus.write(0, 0x10)
        bus.write(1, 0x11)
        bus.write(2, 1)
        wait 2 cycles
        assert bus.read(5) == 0x46
            else fail("addition result mismatch")

        bus.write(0, 0xFE)
        bus.write(1, 0x11)
        bus.write(2, 1)
        wait 2 cycles
        assert bus.read(5) == 0x33
            else fail("overflow addition result mismatch")

        bus.write(0, 0x10)
        bus.write(1, 0x11)
        bus.write(2, 2)
        wait 2 cycles
        assert bus.read(5) == 0xA8
            else fail("multiplication result mismatch")

        bus.write(2, 0)
        wait 2 cycles
        assert bus.read(5) == 0xA8
            else fail("disabled mode changed result unexpectedly")

        bus.mid_reset()
        assert bus.read(0) == 0 else fail("post-reset CSR0 not cleared")
        assert bus.read(1) == 0 else fail("post-reset CSR1 not cleared")
        assert bus.read(2) == 0 else fail("post-reset CSR2 not cleared")

        bus.store_sram(0xFF, 0x7E)
        bus.write(2, 3)
        assert bus.read(0xFF) == 0x7E
            else fail("memory read @0xff mismatch")

        for k in 0 .. 23
            let t : ApbStim
            randomize(t) with
                LegalCsr(t)
                ProperApb(t)
                t.mode in [0..3]
            end randomize

            bus.write(2, t.mode)
            if t.write == 1
                bus.write(t.addr, t.data)
            else
                let rv = bus.read(t.addr)
                assert dut.pslverr == 0
                    else fail("legal random read k=${k} addr=0x${t.addr:03x} raised pslverr")
            end if
        end for

        for k in 0 .. 15
            let t : ApbStim
            randomize(t) with
                InvalidCsr(t)
                ProperApb(t)
                t.mode in [0..2]
            end randomize

            bus.write(2, t.mode)
            bus.invalid_access(t.addr, t.data, t.write)
        end for

        for k in 0 .. 11
            let t : ApbStim
            randomize(t) with
                t.sel == 0 || t.enable == 0
            end randomize

            bus.raw_cycle(t.addr, t.data, t.write, t.sel, t.enable)
            assert dut.pslverr == 0
                else fail("malformed random APB k=${k} raised pslverr without apb_valid")
        end for

        for m in 0 .. 7
            bus.write(2, m as uint<8>)
            wait 1 cycle
        end for

        // Toggle high bits of r_enable and pulse sram_valid while not in
        // MODE_WRITE to cover the no-write side of the SRAM-valid block.
        bus.write(2, 0xF8)
        bus.pulse_sram_valid()
        bus.write(2, 0xFF)
        wait 1 cycle
        bus.write(2, 0)
        wait 1 cycle

        log(info, "ALL TESTS PASSED - apb_dsp_unit")
    end run

    check
        cov.report()

        assert cov.cp_addr.operand1 > 0 else fail("coverage hole: addr operand1")
        assert cov.cp_addr.operand2 > 0 else fail("coverage hole: addr operand2")
        assert cov.cp_addr.enable > 0 else fail("coverage hole: addr enable")
        assert cov.cp_addr.write_addr > 0 else fail("coverage hole: addr write_addr")
        assert cov.cp_addr.write_data > 0 else fail("coverage hole: addr write_data")
        assert cov.cp_addr.result > 0 else fail("coverage hole: addr result")
        assert cov.cp_addr.invalid_low > 0 else fail("coverage hole: addr invalid_low")
        assert cov.cp_addr.invalid_high > 0 else fail("coverage hole: addr invalid_high")

        assert cov.cp_write.read > 0 else fail("coverage hole: APB read")
        assert cov.cp_write.write > 0 else fail("coverage hole: APB write")
        assert cov.cp_handshake.idle > 0 else fail("coverage hole: handshake idle")
        assert cov.cp_handshake.enable_only > 0 else fail("coverage hole: handshake enable_only")
        assert cov.cp_handshake.setup_only > 0 else fail("coverage hole: handshake setup_only")
        assert cov.cp_handshake.active_txn > 0 else fail("coverage hole: handshake active")

        assert cov.cp_mode_data.disabled > 0 else fail("coverage hole: mode disabled")
        assert cov.cp_mode_data.add > 0 else fail("coverage hole: mode add")
        assert cov.cp_mode_data.mult > 0 else fail("coverage hole: mode mult")
        assert cov.cp_mode_data.mem_write > 0 else fail("coverage hole: mode mem_write")
        assert cov.cp_mode_data.invalid_mode > 0 else fail("coverage hole: invalid mode data")

        assert cov.cp_prdata.zero > 0 else fail("coverage hole: prdata zero")
        assert cov.cp_prdata.low > 0 else fail("coverage hole: prdata low")
        assert cov.cp_prdata.mid > 0 else fail("coverage hole: prdata mid")
        assert cov.cp_prdata.max > 0 else fail("coverage hole: prdata max")

        assert cov.cp_ready.low > 0 else fail("coverage hole: pready low")
        assert cov.cp_ready.high > 0 else fail("coverage hole: pready high")
        assert cov.cp_error.clear > 0 else fail("coverage hole: pslverr clear")
        assert cov.cp_error.set > 0 else fail("coverage hole: pslverr set")
    end check
end impl ApbDspTest
