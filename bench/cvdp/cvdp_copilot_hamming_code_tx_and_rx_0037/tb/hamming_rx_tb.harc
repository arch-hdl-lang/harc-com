// HARC testbench for CVDP cid012 `cvdp_copilot_hamming_code_tx_and_rx_0037`.
//
// DUT: hamming_rx (DATA_WIDTH=4, PARITY_BIT=3, ENCODED_DATA=8).
//   - parity[j] = XOR over data_in[i] for i in [1..8) where (i & (1<<j)) != 0
//   - corrected_data = data_in, but if (|parity) != 0,
//       corrected_data[parity] = ~data_in[parity]
//   - data_out = corrected_data[k] for k in [1..8), skipping powers-of-two
//     positions (1,2,4), in increasing-k → increasing-data_out order.
//
// Strategy: exhaustive sweep of all 256 possible 8-bit codewords. This
// hits every branch in both inner loops (parity calc + extraction) and
// drives every input bit through 0/1, every output bit through 0/1.

testbench HammingRxTb
    dut : hamming_rx_top
end testbench HammingRxTb

// Software model mirroring the DUT exactly.
function model_rx(data_in: uint<8>) -> uint<4>
    // Build parity[0..3) over indices 1..8 where (i & (1<<j)) != 0
    let p0 : uint<1> = 0
    let p1 : uint<1> = 0
    let p2 : uint<1> = 0
    for i in 1 .. 8
        let bit = ((data_in >> i) & 1).trunc<1>()
        if (i & 1) != 0
            p0 = p0 ^ bit
        end if
        if (i & 2) != 0
            p1 = p1 ^ bit
        end if
        if (i & 4) != 0
            p2 = p2 ^ bit
        end if
    end for
    let syndrome : uint<3> = ((p2 as uint<3>) << 2) | ((p1 as uint<3>) << 1) | (p0 as uint<3>)

    // Apply correction: if any parity bit set, flip data_in[syndrome].
    let corrected : uint<8> = data_in
    if syndrome != 0
        let mask : uint<8> = (1 as uint<8>) << syndrome
        corrected = corrected ^ mask
    end if

    // Extract data bits: indices k in [1..8) where (k & (k-1)) != 0
    // i.e. skip powers-of-two indices 1,2,4. So k=3,5,6,7 → data_out[0..3].
    let d0 = ((corrected >> 3) & 1).trunc<1>()
    let d1 = ((corrected >> 5) & 1).trunc<1>()
    let d2 = ((corrected >> 6) & 1).trunc<1>()
    let d3 = ((corrected >> 7) & 1).trunc<1>()
    let out : uint<4> = ((d3 as uint<4>) << 3)
                     | ((d2 as uint<4>) << 2)
                     | ((d1 as uint<4>) << 1)
                     |  (d0 as uint<4>)
    return out
end function model_rx

impl HammingRxTest for HammingRxTb
    run
        log(info, "hamming_rx: exhaustive 256-codeword sweep")
        for c in 0 .. 256
            dut.data_in = c
            wait 1 cycle
            let exp = model_rx(c as uint<8>)
            assert dut.data_out == exp
                else fail("data_in=0x${c:02x}: got 0x${dut.data_out:01x}, expected 0x${exp:01x}")
        end for
        log(info, "ALL TESTS PASSED — hamming_rx 256/256 codewords")
    end run
end impl HammingRxTest
