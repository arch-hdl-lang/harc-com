// HARC testbench for CVDP cid012 `cvdp_copilot_skid_register_0004`.
//
// Exercises the upstream/downstream valid-ready combinations, sustained
// backpressure, flush/restart behavior, reset, and solver-randomized payloads.
// The randomized payload uses `[unique within test]` so repeated randomize calls
// prefer fresh 32-bit values while auto coverage steers endpoints and walking
// bit patterns.

transaction SkidStim
    data : uint<32> with [unique within test]
    up_valid : bool
    dn_ready : bool
end transaction SkidStim

bus SkidPipe
    tlm_method transfer(data: uint<32>) -> uint<32>: blocking;
end bus SkidPipe

covergroup SkidCov @(posedge dut.clk)
    cp_up_val : cover dut.up_val
        bins
            low = {0}
            high = {1}
        end bins

    cp_dn_rdy : cover dut.dn_rdy
        bins
            blocked = {0}
            ready = {1}
        end bins

    cp_up_rdy : cover dut.up_rdy
        bins
            blocked = {0}
            ready = {1}
        end bins

    cp_dn_val : cover dut.dn_val
        bins
            empty = {0}
            valid = {1}
        end bins

    cp_data : cover dut.up_bus
        bins
            zero = {0}
            one = {1}
            high_bit = {2147483648}
            ones = {4294967295}
            low = [2..255]
            mid = [256..65535]
            high = [65536..4294967294]
        end bins

    cp_out_data : cover dut.dn_bus
        bins
            zero = {0}
            one = {1}
            high_bit = {2147483648}
            ones = {4294967295}
            nonzero = [2..4294967294]
        end bins

    cross cp_up_val, cp_dn_rdy
    cross cp_up_rdy, cp_dn_val
    cross cp_data, cp_dn_rdy
end covergroup SkidCov

testbench SkidRegisterTb
    dut : skid_register
    cov : SkidCov

    function reset_skid()
        dut.rst = 1
        dut.up_bus = 0
        dut.up_val = 0
        dut.dn_rdy = 0
        wait 3 cycles
        assert dut.up_rdy == 1 else fail("reset: up_rdy expected high")
        assert dut.dn_val == 0 else fail("reset: dn_val expected low")
        dut.rst = 0
        wait 1 cycle
    end function reset_skid
    function drive_skid(data: uint<32>, up_valid: bool, dn_ready: bool)
        dut.up_bus = data
        dut.up_val = up_valid
        dut.dn_rdy = dn_ready
        wait 1 cycle
    end function drive_skid
end testbench SkidRegisterTb

impl SkidRegisterTest for SkidRegisterTb
    let pipe : SkidPipe = bind dut with {
        transfer.req_valid: "up_val",
        transfer.req_ready: "up_rdy",
        transfer.data: "up_bus",
        transfer.rsp_valid: "dn_val",
        transfer.rsp_ready: "dn_rdy",
        transfer.rsp_data: "dn_bus"
    }

    run
        log(info, "skid_register: backpressure, flush, restart, and unique random traffic")

        reset_skid()

        // Continuous no-backpressure streaming.
        drive_skid(0x00000000, true, true)
        drive_skid(0xFFFFFFFF, true, true)
        drive_skid(0x80000000, true, true)
        drive_skid(0x00000001, true, true)
        drive_skid(0xAAAAAAAA, true, true)
        drive_skid(0x55555555, true, true)

        for bit in 0 .. 31
            let one : uint<32> = (1 as uint<32>) << bit
            drive_skid(one, true, true)
            drive_skid((0xFFFFFFFF ^ one).trunc<32>(), true, true)
        end for

        // Full downstream backpressure while upstream keeps asserting valid.
        dut.dn_rdy = 0
        for i in 0 .. 23
            dut.up_val = 1
            dut.up_bus = (0x1000 + i).trunc<32>()
            wait 1 cycle
        end for

        // Flush the skid buffer and output register.
        dut.up_val = 0
        dut.dn_rdy = 1
        wait 8 cycles

        // RHS-fork TLM pipelining: issue two upstream transfers before
        // joining either downstream response. This mirrors ARCH's direct-call
        // fork style for overlapped blocking TLM transactions.
        dut.dn_rdy = 0
        let pipe0 = fork pipe.transfer(0x13579BDF)
        let pipe1 = fork pipe.transfer(0x2468ACE0)
        join_all
        assert pipe0 == 0x13579BDF
            else fail("forked transfer 0 got 0x${pipe0:08x}, expected 0x13579BDF")
        assert pipe1 == 0x2468ACE0
            else fail("forked transfer 1 got 0x${pipe1:08x}, expected 0x2468ACE0")
        dut.up_val = 0
        dut.dn_rdy = 1
        wait 2 cycles

        // Stall/restart pulses and invalid bubbles.
        for i in 0 .. 15
            drive_skid((0x2000 + i).trunc<32>(), true, (i & 1) == 0)
            drive_skid((0x3000 + i).trunc<32>(), false, (i & 2) == 0)
        end for

        // Solver-backed traffic. This exercises unique recycling and natural
        // auto-coverage endpoints for a 32-bit data field.
        for _ in 0 .. 71
            let s : SkidStim
            randomize(s)
            drive_skid(s.data, s.up_valid, s.dn_ready)
        end for

        // End ready with a drained pipeline.
        dut.up_val = 0
        dut.dn_rdy = 1
        wait 10 cycles

        reset_skid()
        log(info, "ALL TESTS PASSED - skid_register")
    end run

    check
        cov.report()

        assert cov.cp_up_val.low > 0 else fail("coverage hole: upstream valid low")
        assert cov.cp_up_val.high > 0 else fail("coverage hole: upstream valid high")
        assert cov.cp_dn_rdy.blocked > 0 else fail("coverage hole: downstream blocked")
        assert cov.cp_dn_rdy.ready > 0 else fail("coverage hole: downstream ready")
        assert cov.cp_up_rdy.blocked > 0 else fail("coverage hole: upstream blocked")
        assert cov.cp_up_rdy.ready > 0 else fail("coverage hole: upstream ready")
        assert cov.cp_dn_val.valid > 0 else fail("coverage hole: downstream valid")
        assert cov.cp_data.zero > 0 else fail("coverage hole: data zero")
        assert cov.cp_data.high_bit > 0 else fail("coverage hole: data high bit")
        assert cov.cp_data.ones > 0 else fail("coverage hole: data all ones")
    end check
end impl SkidRegisterTest
