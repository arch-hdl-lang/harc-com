// HARC testbench for CVDP cid012 `cvdp_copilot_adc_data_rotate_0009`.
//
// Exercises 8-bit rotate data with natural auto coverage. The `data` field is
// intentionally unconstrained so min/max plus walking-one/walking-zero values
// steer the randomized portion of the stimulus.

transaction RotateStim
    data : uint<8>
    shift : uint<4>
    dir : bool
end transaction RotateStim

covergroup RotateCov @(posedge dut.clk)
    cp_data : cover dut.i_adc_data_in
        bins
            zero = {0}
            one = {1}
            high_bit = {128}
            ones = {255}
            alternating_a = {170}
            alternating_5 = {85}
        end bins

    cp_shift : cover dut.i_shift_count
        bins
            zero = {0}
            one = {1}
            width = {8}
            max = {15}
            mid = [2..7]
            wrapped = [9..14]
        end bins

    cp_dir : cover dut.i_shift_direction
        bins
            left = {0}
            right = {1}
        end bins

    cross cp_shift, cp_dir
end covergroup RotateCov

testbench AdcRotateTb
    dut : adc_data_rotate_top
    cov : RotateCov

    function drive_rotate(data: uint<8>, shift: uint<4>, dir: bool)
        dut.i_rst_n = 1
        dut.i_adc_data_in = data
        dut.i_shift_count = shift
        dut.i_shift_direction = dir
        wait 1 cycle
        assert dut.o_operation_status == 1
            else fail("operation_status did not assert")
        assert dut.o_processed_data == rot8(data, shift, dir)
            else fail("rotate data=0x${data:02x} shift=${shift} dir=${dir}: got 0x${dut.o_processed_data:02x}, expected 0x${rot8(data, shift, dir):02x}")
    end function drive_rotate
end testbench AdcRotateTb

function rot8(data: uint<8>, shift: uint<4>, dir: bool) -> uint<8>
    let s : uint<4> = shift % 8
    if dir
        return (((data >> s) | (data << (8 - s))).trunc<8>())
    else
        return (((data << s) | (data >> (8 - s))).trunc<8>())
    end if
end function rot8

impl AdcRotateTest for AdcRotateTb
    run
        log(info, "adc_data_rotate: directed and auto-coverage-driven rotate stimulus")

        dut.i_rst_n = 0
        dut.i_adc_data_in = 0
        dut.i_shift_count = 0
        dut.i_shift_direction = 0
        wait 3 cycles
        assert dut.o_processed_data == 0 else fail("reset did not clear data")
        assert dut.o_operation_status == 0 else fail("reset did not clear status")
        dut.i_rst_n = 1
        wait 1 cycle

        for dir in 0 .. 2
            drive_rotate(0x00, 0, dir == 1)
            drive_rotate(0xFF, 0, dir == 1)
            drive_rotate(0xAA, 0, dir == 1)
            drive_rotate(0x55, 0, dir == 1)
            drive_rotate(0x81, 1, dir == 1)
            drive_rotate(0x18, 3, dir == 1)
            drive_rotate(0xC3, 4, dir == 1)
            drive_rotate(0x3C, 7, dir == 1)
            drive_rotate(0xA5, 8, dir == 1)
            drive_rotate(0x5A, 15, dir == 1)
        end for

        for bit in 0 .. 8
            let data : uint<8> = ((1 as uint<8>) << bit).trunc<8>()
            drive_rotate(data, bit as uint<4>, false)
            drive_rotate((0xFF ^ data).trunc<8>(), (15 - bit) as uint<4>, true)
        end for

        for k in 0 .. 32
            let s : RotateStim
            randomize(s)
            drive_rotate(s.data, s.shift, s.dir)
        end for

        dut.i_rst_n = 0
        wait 1 cycle
        dut.i_rst_n = 1
        wait 1 cycle

        log(info, "ALL TESTS PASSED - adc_data_rotate")
    end run

    check
        cov.report()

        assert cov.cp_data.zero > 0 else fail("coverage hole: zero data")
        assert cov.cp_data.one > 0 else fail("coverage hole: walking-one bit0")
        assert cov.cp_data.high_bit > 0 else fail("coverage hole: walking-one high bit")
        assert cov.cp_data.ones > 0 else fail("coverage hole: all ones")
        assert cov.cp_shift.zero > 0 else fail("coverage hole: shift zero")
        assert cov.cp_shift.width > 0 else fail("coverage hole: shift width")
        assert cov.cp_shift.max > 0 else fail("coverage hole: shift max")
        assert cov.cp_dir.left > 0 else fail("coverage hole: left rotate")
        assert cov.cp_dir.right > 0 else fail("coverage hole: right rotate")
    end check
end impl AdcRotateTest
