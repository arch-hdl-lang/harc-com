// HARC testbench for CVDP cid012 `cvdp_copilot_wb2ahb_0004`.
//
// DUT: Wishbone-to-AHB bridge with a Wishbone-facing primary clock and an AHB
// clock input exposed by the generated wrapper.
//
// Strategy: declare generated Wishbone/AHB clocks, then cover Wishbone
// read/write requests, byte/half/word select decoding, default select
// behavior, AHB wait-state address holding, idle/busy/nonseq transfer states,
// read-data byte swapping, and boundary addresses.

transaction WbAhbStim
    tag : uint<8> with [unique within test]
    index : uint<6> with [unique within test]
    data : uint<32> with [unique within test]
    write : bool
end transaction WbAhbStim

covergroup WbAhbCov @(posedge dut.clk)
    cp_sel : cover dut.sel_i
        bins
            byte0 = {1}
            byte1 = {2}
            byte2 = {4}
            byte3 = {8}
            half_low = {3}
            half_high = {12}
            word = {15}
            default_sel = {0}
        end bins

    cp_hsize : cover dut.hsize
        bins
            byte = {0}
            half = {1}
            word = {2}
        end bins

    cp_htrans : cover dut.htrans
        bins
            idle = {0}
            busy = {1}
            nonseq = {2}
        end bins

    cp_write : cover dut.hwrite
        bins
            read = {0}
            write = {1}
        end bins

    cp_ready : cover dut.hready
        bins
            stalled = {0}
            ready = {1}
        end bins

    cp_ack : cover dut.ack_o
        bins
            low = {0}
            high = {1}
        end bins

    cp_addr_low : cover dut.haddr[1:0]
        bins
            a0 = {0}
            a1 = {1}
            a2 = {2}
            a3 = {3}
        end bins

    cross cp_sel, cp_hsize
    cross cp_write, cp_ack
    cross cp_ready, cp_htrans
end covergroup WbAhbCov

testbench WbAhbBridgeTb
    dut : wishbone_to_ahb_bridge_top
    cov : WbAhbCov

    function reset_bridge()
        dut.rst_i = 1
        dut.hreset_n = 0
        dut.cyc_i = 0
        dut.stb_i = 0
        dut.sel_i = 0
        dut.we_i = 0
        dut.addr_i = 0
        dut.data_i = 0
        dut.hrdata = 0
        dut.hresp = 0
        dut.hready = 1
        wait 2 cycles on hclk
        assert dut.ack_o == 0 else fail("reset: ack_o high")
        assert dut.hburst == 0 else fail("reset: hburst not SINGLE")
        dut.hreset_n = 1
        dut.rst_i = 0
        wait 1 cycle on hclk
    end function reset_bridge
    function idle_bridge()
        dut.cyc_i = 0
        dut.stb_i = 0
        dut.we_i = 0
        dut.hready = 1
        wait 1 cycle on hclk
    end function idle_bridge
    function busy_cycle()
        dut.cyc_i = 1
        dut.stb_i = 0
        dut.hready = 1
        wait 1 cycle on hclk
        assert dut.htrans == 1 else fail("busy cycle: htrans expected BUSY")
        idle_bridge()
    end function busy_cycle
    function address_phase_expr_sweep()
        // Exercise false subterms of the AHB data-phase entry condition while
        // `ahb_data_phase` is known low. These are not distinct bus transactions,
        // but Verilator records them as expression coverage on the condition.
        dut.sel_i = 15
        dut.addr_i = 0x00000020
        dut.data_i = 0x2468ACE0
        dut.hrdata = 0
        dut.we_i = 0

        dut.cyc_i = 1
        dut.stb_i = 1
        dut.hready = 0
        wait 1 cycle on hclk

        dut.cyc_i = 0
        dut.stb_i = 1
        dut.hready = 1
        wait 1 cycle on hclk

        dut.cyc_i = 1
        dut.stb_i = 0
        dut.hready = 1
        wait 1 cycle on hclk

        idle_bridge()
    end function address_phase_expr_sweep
    function stalled_data_phase()
        dut.cyc_i = 1
        dut.stb_i = 1
        dut.we_i = 0
        dut.sel_i = 15
        dut.addr_i = 0x00000040
        dut.data_i = 0
        dut.hrdata = 0x01234567
        dut.hready = 1
        wait 1 cycle on hclk

        dut.hready = 0
        wait 1 cycle on hclk
        assert dut.ack_o == 0 else fail("stalled data phase: ack high")

        dut.hready = 1
        wait 1 cycle on hclk
        idle_bridge()
    end function stalled_data_phase
    function transfer(sel: uint<4>, write: bool, addr: uint<32>, data: uint<32>, hrdata: uint<32>, wait_cycles: uint<4>) -> uint<1>
        dut.cyc_i = 1
        dut.stb_i = 1
        dut.we_i = write
        dut.sel_i = sel
        dut.addr_i = addr
        dut.data_i = data
        dut.hrdata = hrdata
        dut.hresp = 0

        for _ in 0 .. wait_cycles
            dut.hready = 0
            wait 1 cycle on hclk
            if dut.ack_o != 0
                log(error, "wait-state transfer acked early sel=${sel:x} addr=${addr:8x}")
                return 1
            end if
        end for

        dut.hready = 1
        wait 1 cycle on hclk

        let want_addr : uint<32> = aligned_addr(addr, sel)
        let want_size : uint<3> = expected_size(sel)
        if dut.haddr != want_addr
            log(error, "haddr=${dut.haddr:8x} expected=${want_addr:8x} sel=${sel:x}")
            return 1
        end if
        if dut.hsize != want_size
            log(error, "hsize=${dut.hsize} expected=${want_size} sel=${sel:x}")
            return 1
        end if
        if dut.hwrite != write
            log(error, "hwrite mismatch sel=${sel:x}")
            return 1
        end if
        if dut.ack_o != 1
            log(error, "transfer did not ack sel=${sel:x} addr=${addr:8x}")
            return 1
        end if
        if not write
            let expected : uint<32> = expected_read_data(sel, hrdata)
            if dut.data_o != expected
                log(error, "data_o=${dut.data_o:8x} expected=${expected:8x} sel=${sel:x}")
                return 1
            end if
        end if

        wait 1 cycle on hclk
        idle_bridge()
        return 0
    end function transfer
end testbench WbAhbBridgeTb

function make_addr(tag: uint<8>, index: uint<6>) -> uint<32>
    return ((tag as uint<32>) << 8) | ((index as uint<32>) << 2)
end function make_addr

function aligned_addr(addr: uint<32>, sel: uint<4>) -> uint<32>
    let base : uint<32> = addr & 0xFFFFFFFC
    if sel == 1
        return base
    elsif sel == 2
        return base | 1
    elsif sel == 4
        return base | 2
    elsif sel == 8
        return base | 3
    elsif sel == 3
        return base
    elsif sel == 12
        return base | 2
    elsif sel == 15
        return base
    else
        return addr
    end if
end function aligned_addr

function expected_size(sel: uint<4>) -> uint<3>
    if sel == 1 or sel == 2 or sel == 4 or sel == 8
        return 0
    elsif sel == 3 or sel == 12
        return 1
    else
        return 2
    end if
end function expected_size

function expected_read_data(sel: uint<4>, hrdata: uint<32>) -> uint<32>
    if sel == 1 or sel == 2 or sel == 4 or sel == 8
        return ((hrdata & 0x000000FF) << 24) |
               ((hrdata & 0x0000FF00) << 8) |
               ((hrdata & 0x00FF0000) >> 8) |
               ((hrdata & 0xFF000000) >> 24)
    elsif sel == 3 or sel == 12
        return ((hrdata & 0x0000FFFF) << 16) |
               ((hrdata & 0xFFFF0000) >> 16)
    else
        return hrdata
    end if
end function expected_read_data

impl WbAhbBridgeTest for WbAhbBridgeTb
    clock clk = 10ns
    clock hclk = 7ns

    run
        log(info, "wb2ahb: generated AHB clock, select decoding, wait states, and randomized requests")

        reset_bridge()
        let errors : uint<32> = 0

        address_phase_expr_sweep()
        stalled_data_phase()
        busy_cycle()

        errors = errors + transfer(1, false, 0x00000000, 0x11223344, 0xA1B2C3D4, 0)
        errors = errors + transfer(2, true, 0x00000000, 0x01020304, 0x00000000, 1)
        errors = errors + transfer(4, false, 0x00000000, 0x55667788, 0x0A0B0C0D, 2)
        errors = errors + transfer(8, true, 0x00000000, 0xFFEEDDCC, 0x00000000, 0)
        errors = errors + transfer(3, false, 0x00000010, 0x12345678, 0x11112222, 1)
        errors = errors + transfer(12, true, 0x00000010, 0x89ABCDEF, 0x00000000, 2)
        errors = errors + transfer(15, false, 0xFFFFFFFC, 0xCAFEBABE, 0xDEADBEEF, 0)
        errors = errors + transfer(0, true, 0x00000003, 0x13579BDF, 0x00000000, 1)

        for _ in 0 .. 16
            let s : WbAhbStim
            randomize(s)
            let addr : uint<32> = make_addr(s.tag, s.index)
            let sel : uint<4> = 15
            errors = errors + transfer(sel, s.write, addr, s.data, s.data ^ 0xA5A5A5A5, 0)
        end for

        reset_bridge()
        assert errors == 0 else fail("wb2ahb produced ${errors} protocol errors")
        log(info, "ALL TESTS PASSED - wb2ahb")
    end run

    check
        cov.report()

        assert cov.cp_sel.byte0 > 0 else fail("coverage hole: byte lane 0")
        assert cov.cp_sel.byte1 > 0 else fail("coverage hole: byte lane 1")
        assert cov.cp_sel.byte2 > 0 else fail("coverage hole: byte lane 2")
        assert cov.cp_sel.byte3 > 0 else fail("coverage hole: byte lane 3")
        assert cov.cp_sel.half_low > 0 else fail("coverage hole: half low")
        assert cov.cp_sel.half_high > 0 else fail("coverage hole: half high")
        assert cov.cp_sel.word > 0 else fail("coverage hole: word")
        assert cov.cp_sel.default_sel > 0 else fail("coverage hole: default select")
        assert cov.cp_htrans.idle > 0 else fail("coverage hole: IDLE htrans")
        assert cov.cp_htrans.busy > 0 else fail("coverage hole: BUSY htrans")
        assert cov.cp_htrans.nonseq > 0 else fail("coverage hole: NONSEQ htrans")
        assert cov.cp_ready.stalled > 0 else fail("coverage hole: AHB wait state")
        assert cov.cp_ack.high > 0 else fail("coverage hole: ack high")
        assert cov.cp_addr_low.a0 > 0 else fail("coverage hole: addr low 0")
        assert cov.cp_addr_low.a1 > 0 else fail("coverage hole: addr low 1")
        assert cov.cp_addr_low.a2 > 0 else fail("coverage hole: addr low 2")
        assert cov.cp_addr_low.a3 > 0 else fail("coverage hole: addr low 3")
    end check
end impl WbAhbBridgeTest
