// HARC testbench for CVDP cid012 `cvdp_copilot_events_to_apb_0021`.
//
// DUT: APB write controller that latches A/B/C event pulses, selects one
// queued event at a time by priority, emits APB SETUP/ACCESS phases, and
// aborts an ACCESS phase on timeout if the peripheral never becomes ready.
//
// Strategy: generated single-clock stimulus with directed single-event,
// simultaneous-priority, queued, delayed-ready, and timeout cases. A short
// randomized tail varies address/data payloads while preserving protocol
// timing.

transaction ApbEventStim
    tag : uint<8> with [unique within test]
    index : uint<8> with [unique within test]
    data : uint<32> with [unique within test]
end transaction ApbEventStim

covergroup EventsApbCov @(posedge dut.clk)
    cp_select : cover ((dut.select_a_i << 2) | (dut.select_b_i << 1) | dut.select_c_i)
        bins
            none = {0}
            c_only = {1}
            b_only = {2}
            bc = {3}
            a_only = {4}
            ab = {6}
            abc = {7}
        end bins

    cp_psel : cover dut.apb_psel_o
        bins
            low = {0}
            high = {1}
        end bins

    cp_penable : cover dut.apb_penable_o
        bins
            low = {0}
            high = {1}
        end bins

    cp_pready : cover dut.apb_pready_i
        bins
            stalled = {0}
            ready = {1}
        end bins

    cp_pwrite : cover dut.apb_pwrite_o
        bins
            low = {0}
            high = {1}
        end bins

    cp_addr : cover dut.apb_paddr_o[7:0]
        bins
            idle = {0}
            a_addr = {16}
            b_addr = {32}
            c_addr = {48}
            timeout_addr = {64}
            random = [1..255]
        end bins

    cp_data : cover dut.apb_pwdata_o
        bins
            zero = {0}
            a_data = {286331153}
            b_data = {572662306}
            c_data = {858993459}
            timeout_data = {1145324612}
            other = [1..4294967295]
        end bins

    cross cp_psel, cp_penable
    cross cp_pready, cp_penable
    cross cp_select, cp_addr
end covergroup EventsApbCov

testbench EventsToApbTb
    dut : apb_controller
    cov : EventsApbCov

    function reset_ctrl()
        dut.reset_n = 0
        dut.select_a_i = 0
        dut.select_b_i = 0
        dut.select_c_i = 0
        dut.addr_a_i = 0
        dut.data_a_i = 0
        dut.addr_b_i = 0
        dut.data_b_i = 0
        dut.addr_c_i = 0
        dut.data_c_i = 0
        dut.apb_pready_i = 1
        wait 3 cycles on clk
        assert dut.apb_psel_o == 0 else fail("reset: psel high")
        assert dut.apb_penable_o == 0 else fail("reset: penable high")
        assert dut.apb_pwrite_o == 0 else fail("reset: pwrite high")
        assert dut.apb_paddr_o == 0 else fail("reset: paddr nonzero")
        assert dut.apb_pwdata_o == 0 else fail("reset: pwdata nonzero")
        dut.reset_n = 1
        wait 1 cycle on clk
    end function reset_ctrl
    function set_payloads(addr_a: uint<32>, data_a: uint<32>, addr_b: uint<32>, data_b: uint<32>, addr_c: uint<32>, data_c: uint<32>)
        dut.addr_a_i = addr_a
        dut.data_a_i = data_a
        dut.addr_b_i = addr_b
        dut.data_b_i = data_b
        dut.addr_c_i = addr_c
        dut.data_c_i = data_c
    end function set_payloads
    function pulse_events(a: bool, b: bool, c: bool)
        dut.select_a_i = a
        dut.select_b_i = b
        dut.select_c_i = c
        wait 1 cycle on clk
        dut.select_a_i = 0
        dut.select_b_i = 0
        dut.select_c_i = 0
        wait 1 cycle on clk
    end function pulse_events
    function wait_for_setup(limit: uint<8>) -> uint<1>
        for _ in 0 .. limit
            if dut.apb_psel_o == 1 and dut.apb_penable_o == 0
                return 0
            end if
            wait 1 cycle on clk
        end for
        log(error, "timeout waiting for APB SETUP")
        return 1
    end function wait_for_setup
    function wait_for_idle(limit: uint<8>) -> uint<1>
        for _ in 0 .. limit
            if dut.apb_psel_o == 0 and dut.apb_penable_o == 0
                return 0
            end if
            wait 1 cycle on clk
        end for
        log(error, "timeout waiting for APB idle")
        return 1
    end function wait_for_idle
    function expect_setup(want_addr: uint<32>, want_data: uint<32>) -> uint<1>
        if wait_for_setup(12) != 0
            return 1
        end if
        if dut.apb_pwrite_o != 1
            log(error, "SETUP pwrite low")
            return 1
        end if
        if dut.apb_paddr_o != want_addr
            log(error, "SETUP addr=${dut.apb_paddr_o:08x} expected=${want_addr:08x}")
            return 1
        end if
        if dut.apb_pwdata_o != want_data
            log(error, "SETUP data=${dut.apb_pwdata_o:08x} expected=${want_data:08x}")
            return 1
        end if
        return 0
    end function expect_setup
    function complete_current(ready_delay: uint<5>) -> uint<1>
        dut.apb_pready_i = 0
        wait 1 cycle on clk
        for _ in 0 .. ready_delay
            dut.apb_pready_i = 0
            wait 1 cycle on clk
            if dut.apb_penable_o == 1 and dut.apb_psel_o == 1
                // Expected ACCESS stall.
            end if
        end for
        dut.apb_pready_i = 1
        wait 1 cycle on clk
        return wait_for_idle(8)
    end function complete_current
    function trigger_and_complete(a: bool, b: bool, c: bool, want_addr: uint<32>, want_data: uint<32>, ready_delay: uint<5>) -> uint<1>
        pulse_events(a, b, c)
        if expect_setup(want_addr, want_data) != 0
            return 1
        end if
        return complete_current(ready_delay)
    end function trigger_and_complete
    function timeout_current(want_addr: uint<32>, want_data: uint<32>) -> uint<1>
        if expect_setup(want_addr, want_data) != 0
            return 1
        end if
        dut.apb_pready_i = 0
        wait 18 cycles on clk
        dut.apb_pready_i = 1
        return wait_for_idle(8)
    end function timeout_current
end testbench EventsToApbTb

function make_addr(tag: uint<8>, index: uint<8>) -> uint<32>
    return ((tag as uint<32>) << 8) | ((index as uint<32>) << 2)
end function make_addr

impl EventsToApbTest for EventsToApbTb
    clock clk = 10ns

    run
        log(info, "events_to_apb: priority, queue, wait-state, timeout, and randomized event stimulus")

        reset_ctrl()
        let errors : uint<32> = 0

        set_payloads(0x00000010, 0x11111111,
            0x00000020, 0x22222222,
            0x00000030, 0x33333333)

        errors = errors + trigger_and_complete(true, false, false, 0x00000010, 0x11111111, 0)
        errors = errors + trigger_and_complete(false, true, false, 0x00000020, 0x22222222, 2)
        errors = errors + trigger_and_complete(false, false, true, 0x00000030, 0x33333333, 1)

        // Simultaneous events choose A first, then queued B, then queued C.
        pulse_events(true, true, true)
        errors = errors + expect_setup(0x00000010, 0x11111111)
        errors = errors + complete_current(0)
        errors = errors + expect_setup(0x00000020, 0x22222222)
        errors = errors + complete_current(0)
        errors = errors + expect_setup(0x00000030, 0x33333333)
        errors = errors + complete_current(0)

        // BC simultaneous chooses B first, then C.
        pulse_events(false, true, true)
        errors = errors + expect_setup(0x00000020, 0x22222222)
        errors = errors + complete_current(3)
        errors = errors + expect_setup(0x00000030, 0x33333333)
        errors = errors + complete_current(0)

        // Timeout abort while in ACCESS.
        set_payloads(0x00000040, 0x44444444,
            0x00000020, 0x22222222,
            0x00000030, 0x33333333)
        pulse_events(true, false, false)
        errors = errors + timeout_current(0x00000040, 0x44444444)

        // Randomized payloads for event A. Use one event at a time so the
        // data/addr checker remains simple while the solver still varies
        // 32-bit APB payloads.
        for _ in 0 .. 12
            let s : ApbEventStim
            randomize(s)
            let addr : uint<32> = make_addr(s.tag, s.index)
            set_payloads(addr, s.data, 0x00000020, 0x22222222, 0x00000030, 0x33333333)
            errors = errors + trigger_and_complete(true, false, false, addr, s.data, 0)
        end for

        reset_ctrl()
        assert errors == 0 else fail("events_to_apb produced ${errors} protocol errors")
        log(info, "ALL TESTS PASSED - events_to_apb")
    end run

    check
        cov.report()

        assert cov.cp_select.a_only > 0 else fail("coverage hole: select A")
        assert cov.cp_select.b_only > 0 else fail("coverage hole: select B")
        assert cov.cp_select.c_only > 0 else fail("coverage hole: select C")
        assert cov.cp_select.bc > 0 else fail("coverage hole: select BC")
        assert cov.cp_select.abc > 0 else fail("coverage hole: select ABC")
        assert cov.cp_psel.high > 0 else fail("coverage hole: PSEL high")
        assert cov.cp_penable.high > 0 else fail("coverage hole: PENABLE high")
        assert cov.cp_pready.stalled > 0 else fail("coverage hole: PREADY wait")
        assert cov.cp_pwrite.high > 0 else fail("coverage hole: PWRITE high")
        assert cov.cp_addr.a_addr > 0 else fail("coverage hole: A address")
        assert cov.cp_addr.b_addr > 0 else fail("coverage hole: B address")
        assert cov.cp_addr.c_addr > 0 else fail("coverage hole: C address")
        assert cov.cp_addr.timeout_addr > 0 else fail("coverage hole: timeout address")
    end check
end impl EventsToApbTest
