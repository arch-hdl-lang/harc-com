// HARC testbench for CVDP cid012 `cvdp_copilot_endian_swapper_0004`.
//
// Stimulus-only AXI-stream/CSR exerciser for the 64-bit endian swapper.
// Randomized stream data uses `[unique within test]` plus natural auto
// coverage to prefer min/max and walking-bit payloads.

transaction StreamStim
    hi : uint<32>
    lo : uint<32> with [unique within test]
    empty : uint<3>
    sop : bool
    eop : bool
    ready_gap : uint<3> with [range(0, 7)]
end transaction StreamStim

covergroup EndianCov @(posedge dut.clk)
    cp_in_data : cover dut.stream_in_data
        bins
            zero = {0}
            one = {1}
            high_bit = {9223372036854775808}
            ones = {18446744073709551615}
            byte_walk = {72623859790382856}
        end bins

    cp_empty : cover dut.stream_in_empty
        bins
            zero = {0}
            one = {1}
            mid = [2..6]
            max = {7}
        end bins

    cp_in_valid : cover dut.stream_in_valid
        bins
            low = {0}
            high = {1}
        end bins

    cp_in_ready : cover dut.stream_in_ready
        bins
            stalled = {0}
            ready = {1}
        end bins

    cp_out_ready : cover dut.stream_out_ready
        bins
            stalled = {0}
            ready = {1}
        end bins

    cp_out_valid : cover dut.stream_out_valid
        bins
            low = {0}
            high = {1}
        end bins

    cp_packet : cover ((dut.stream_in_startofpacket << 1) | dut.stream_in_endofpacket)
        bins
            middle = {0}
            eop_only = {1}
            sop_only = {2}
            single = {3}
        end bins

    cp_csr_addr : cover dut.csr_address
        bins
            control = {0}
            packet_count = {1}
            invalid2 = {2}
            invalid3 = {3}
        end bins

    cp_csr_cmd : cover ((dut.csr_write << 1) | dut.csr_read)
        bins
            idle = {0}
            read = {1}
            write = {2}
            both = {3}
        end bins

    cp_csr_wait : cover dut.csr_waitrequest
        bins
            free = {0}
            stalled = {1}
        end bins

    cp_csr_rvalid : cover dut.csr_readdatavalid
        bins
            low = {0}
            high = {1}
        end bins

    cross cp_in_valid, cp_in_ready
    cross cp_out_ready, cp_out_valid
    cross cp_csr_addr, cp_csr_cmd
end covergroup EndianCov

testbench EndianSwapperTb
    dut : endian_swapper
    cov : EndianCov

    function reset_endian()
        dut.reset_n = 0
        dut.stream_in_data = 0
        dut.stream_in_empty = 0
        dut.stream_in_valid = 0
        dut.stream_in_startofpacket = 0
        dut.stream_in_endofpacket = 0
        dut.stream_out_ready = 0
        dut.csr_address = 0
        dut.csr_read = 0
        dut.csr_write = 0
        dut.csr_writedata = 0
        wait 4 cycles
        dut.reset_n = 1
        wait 2 cycles
    end function reset_endian
    function csr_idle()
        dut.csr_read = 0
        dut.csr_write = 0
        dut.csr_address = 0
        dut.csr_writedata = 0
        wait 1 cycle
    end function csr_idle
    function csr_write(addr: uint<2>, data: uint<32>)
        dut.csr_address = addr
        dut.csr_writedata = data
        dut.csr_read = 0
        dut.csr_write = 1
        wait 1 cycle
        csr_idle()
    end function csr_write
    function csr_read(addr: uint<2>) -> uint<32>
        dut.csr_address = addr
        dut.csr_read = 1
        dut.csr_write = 0
        wait 1 cycle
        let val = dut.csr_readdata
        csr_idle()
        return val
    end function csr_read
    function stream_idle()
        dut.stream_in_valid = 0
        dut.stream_in_startofpacket = 0
        dut.stream_in_endofpacket = 0
        wait 1 cycle
    end function stream_idle
    function send_word(data: uint<64>, empty: uint<3>, sop: bool, eop: bool, ready_gap: uint<3>)
        dut.stream_in_data = data
        dut.stream_in_empty = empty
        dut.stream_in_startofpacket = sop
        dut.stream_in_endofpacket = eop
        dut.stream_in_valid = 1
        for _ in 1 .. ready_gap
            dut.stream_out_ready = 0
            wait 1 cycle
        end for
        dut.stream_out_ready = 1
        wait 2 cycles
        stream_idle()
        wait 1 cycle
    end function send_word
end testbench EndianSwapperTb

impl EndianSwapperTest for EndianSwapperTb
    run
        log(info, "endian_swapper: CSR, packet, backpressure, and 64-bit auto coverage")

        reset_endian()

        // CSR setup and readback stimulus.
        let _c0 = csr_read(0)
        let _pc0 = csr_read(1)
        let _bad2 = csr_read(2)
        csr_write(0, 0)
        csr_write(0, 1)
        csr_write(1, 0xFFFFFFFF)
        dut.csr_read = 1
        dut.csr_write = 1
        dut.csr_address = 3
        dut.csr_writedata = 0xAAAAAAAA
        wait 1 cycle
        csr_idle()

        // Directed packets with and without byte swapping.
        csr_write(0, 0)
        send_word(0x0000000000000000, 0, true, true, 0)
        send_word(0xFFFFFFFFFFFFFFFF, 7, true, true, 1)
        send_word(0x0102030405060708, 0, true, false, 2)
        send_word(0x8877665544332211, 3, false, true, 0)

        csr_write(0, 1)
        send_word(0x0123456789ABCDEF, 0, true, true, 3)
        send_word(0x8000000000000000, 1, true, false, 4)
        send_word(0x0000000000000001, 7, false, true, 1)

        // Fill both buffer slots while output is stalled, then drain.
        dut.stream_out_ready = 0
        dut.stream_in_data = 0x1111111111111111
        dut.stream_in_empty = 0
        dut.stream_in_startofpacket = 1
        dut.stream_in_endofpacket = 0
        dut.stream_in_valid = 1
        wait 1 cycle
        dut.stream_in_data = 0x2222222222222222
        dut.stream_in_startofpacket = 0
        dut.stream_in_endofpacket = 1
        wait 2 cycles
        dut.stream_out_ready = 1
        wait 4 cycles
        stream_idle()

        for bit in 0 .. 63
            let data : uint<64> = ((1 as uint<64>) << bit).trunc<64>()
            send_word(data, (bit % 8) as uint<3>, bit == 0, bit == 63, (bit % 4) as uint<3>)
            send_word((0xFFFFFFFFFFFFFFFF ^ data).trunc<64>(), (7 - (bit % 8)) as uint<3>, bit == 63, bit == 0, (bit % 3) as uint<3>)
        end for

        for _ in 0 .. 47
            let s : StreamStim
            randomize(s)
            let data : uint<64> = (((s.hi as uint<64>) << 32) | (s.lo as uint<64>))
            send_word(data, s.empty, s.sop, s.eop, s.ready_gap)
        end for

        let _pc1 = csr_read(1)

        log(info, "ALL TESTS PASSED - endian_swapper")
    end run

    check
        cov.report()

        assert cov.cp_in_data.zero > 0 else fail("coverage hole: zero stream word")
        assert cov.cp_in_data.high_bit > 0 else fail("coverage hole: high-bit stream word")
        assert cov.cp_in_data.ones > 0 else fail("coverage hole: all-ones stream word")
        assert cov.cp_empty.max > 0 else fail("coverage hole: empty max")
        assert cov.cp_in_ready.stalled > 0 else fail("coverage hole: input backpressure")
        assert cov.cp_out_ready.stalled > 0 else fail("coverage hole: output backpressure")
        assert cov.cp_out_valid.high > 0 else fail("coverage hole: output valid")
        assert cov.cp_packet.single > 0 else fail("coverage hole: single-word packet")
        assert cov.cp_packet.sop_only > 0 else fail("coverage hole: SOP")
        assert cov.cp_packet.eop_only > 0 else fail("coverage hole: EOP")
        assert cov.cp_csr_addr.control > 0 else fail("coverage hole: CSR control")
        assert cov.cp_csr_addr.packet_count > 0 else fail("coverage hole: CSR packet count")
        assert cov.cp_csr_cmd.read > 0 else fail("coverage hole: CSR read")
        assert cov.cp_csr_cmd.write > 0 else fail("coverage hole: CSR write")
        assert cov.cp_csr_wait.stalled > 0 else fail("coverage hole: CSR waitrequest")
    end check
end impl EndianSwapperTest
