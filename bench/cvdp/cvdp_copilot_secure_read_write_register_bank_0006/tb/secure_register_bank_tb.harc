// HARC stimulus bench for CVDP cid012 `cvdp_copilot_secure_read_write_register_bank_0006`.

testbench SecureRegisterBankTb
    dut : secure_read_write_register_bank_top
end testbench SecureRegisterBankTb

function pulse(dut: secure_read_write_register_bank_top)
    dut.i_capture_pulse = 0
    wait 1 cycle
    dut.i_capture_pulse = 1
    wait 1 cycle
    dut.i_capture_pulse = 0
    wait 1 cycle
end function pulse

function write_reg(dut: secure_read_write_register_bank_top, addr: uint<8>, data: uint<8>)
    dut.i_addr = addr
    dut.i_data_in = data
    dut.i_read_write_enable = 0
    pulse(dut)
end function write_reg

function read_reg(dut: secure_read_write_register_bank_top, addr: uint<8>)
    dut.i_addr = addr
    dut.i_data_in = 0
    dut.i_read_write_enable = 1
    pulse(dut)
end function read_reg

impl SecureRegisterBankTest for SecureRegisterBankTb
    run
        log(info, "secure register bank: unlock, read/write, relock, restricted access")
        dut.i_rst_n = 0
        dut.i_capture_pulse = 0
        dut.i_addr = 0
        dut.i_data_in = 0
        dut.i_read_write_enable = 0
        wait 3 cycles
        dut.i_rst_n = 1

        read_reg(dut, 2)
        write_reg(dut, 0, 0xAB)
        write_reg(dut, 2, 0x55)  // wrong step-two address relocks
        write_reg(dut, 0, 0xAB)
        write_reg(dut, 1, 0xCD)

        for k in 2 .. 18
            write_reg(dut, k, (k * 13) & 0xFF)
            read_reg(dut, k)
        end for
        read_reg(dut, 0)
        read_reg(dut, 1)

        // Incorrect code on restricted address while unlocked relocks.
        write_reg(dut, 0, 0x00)
        read_reg(dut, 2)

        // Unlock again and relock through the address-1 side of the OR.
        write_reg(dut, 0, 0xAB)
        write_reg(dut, 1, 0xCD)
        write_reg(dut, 1, 0x00)

        // Unlock again and exercise read-enable cases with matching unlock
        // data still on the bus; these cover the short-circuit subterms in
        // the relock expression while i_read_write_enable is high.
        write_reg(dut, 0, 0xAB)
        write_reg(dut, 1, 0xCD)
        dut.i_addr = 1
        dut.i_data_in = 0xCD
        dut.i_read_write_enable = 1
        pulse(dut)
        dut.i_addr = 0
        dut.i_data_in = 0xAB
        dut.i_read_write_enable = 1
        pulse(dut)

        // Touch high address.
        write_reg(dut, 0xFF, 0x5A)
        read_reg(dut, 0xFF)

        dut.i_rst_n = 0
        wait 2 cycles
        dut.i_rst_n = 1
        log(info, "secure register bank stimulus complete")
    end run
end impl SecureRegisterBankTest
