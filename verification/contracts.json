{
  "schema_version": 1,
  "contracts": [
    {
      "id": "parser-boundaries",
      "area": "parser",
      "owner": "src/parser.rs",
      "domain": "Rust unit tests and CLI fixtures; grammar cases enumerated by tests, not all programs",
      "checks": [
        "rust-lib",
        "check_cli"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "arithmetic-kernels",
      "area": "arithmetic",
      "owner": "runtime/harc_thread_rt.h; src/numeric_semantics.rs",
      "domain": "42 symbolic obligations with exact domains in docs/formal-arithmetic.md; division equivalence widths 1..8 only",
      "checks": [
        "arithmetic-formal",
        "proof-runner"
      ],
      "required": true,
      "formal": true
    },
    {
      "id": "solver-capture",
      "area": "solver",
      "owner": "src/codegen/native/constraint_solver_renderer.rs",
      "domain": "Bounded native Boolean and signed-width capture SAT/UNSAT fixtures",
      "checks": [
        "native_signed_capture_e2e",
        "native_bool_capture_e2e",
        "arithmetic_solver_conformance"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "control-flow",
      "area": "control",
      "owner": "src/codegen/tbir/func.rs",
      "domain": "Bounded fatal wait, helper continuation and argument-order fixtures",
      "checks": [
        "fatal_wall_wait_e2e",
        "tbir_void_helper_e2e"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "component-ownership",
      "area": "components",
      "owner": "src/ir/lower/components_impl.rs",
      "domain": "Bounded callback receiver ownership and sub-assignment fixtures",
      "checks": [
        "tbir_component_local_init",
        "tbir_component_sub_assign"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "clock-progress",
      "area": "clocks",
      "owner": "runtime/harc_thread_rt.h",
      "domain": "Bounded fatal waits and temporal helper scenarios; no scheduler proof",
      "checks": [
        "fatal_wall_wait_e2e",
        "temporal_helpers_e2e"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "aggregate-widths",
      "area": "aggregates",
      "owner": "src/codegen/tbir/expr.rs",
      "domain": "Rust unit suite and bounded wide coverage selector fixtures; no arbitrary nesting proof",
      "checks": [
        "rust-lib",
        "tbir_wide_cover_selectors_e2e"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "coverage-ordering",
      "area": "coverage",
      "owner": "src/codegen/tbir/covergroup.rs",
      "domain": "Bounded signed static bounds and wide selector fixtures",
      "checks": [
        "static_cover_bins_e2e",
        "tbir_wide_cover_selectors_e2e"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "cli-launch",
      "area": "CLI",
      "owner": "src/main.rs",
      "domain": "Rust CLI tests including launcher routing; stub routing is not DUT verification",
      "checks": [
        "rust-cli",
        "check_cli"
      ],
      "required": true,
      "formal": false
    },
    {
      "id": "ral-assignment",
      "area": "RAL",
      "owner": "src/codegen/native.rs",
      "domain": "Bounded native register assignment fixture",
      "checks": [
        "native_ral_assignment_e2e"
      ],
      "required": true,
      "formal": false
    }
  ],
  "checks": [
    {
      "id": "rust-lib",
      "command": [
        "cargo",
        "test",
        "--lib"
      ],
      "parser": "rust",
      "timeout": 1800
    },
    {
      "id": "rust-cli",
      "command": [
        "cargo",
        "test",
        "--bin",
        "harc"
      ],
      "parser": "rust",
      "timeout": 600
    },
    {
      "id": "proof-runner",
      "command": [
        "python3",
        "proofs/arithmetic/test_runner.py"
      ],
      "parser": "unittest",
      "expected_tests": 10,
      "timeout": 120
    },
    {
      "id": "arithmetic-formal",
      "command": [
        "python3",
        "proofs/arithmetic/run.py",
        "--out",
        "{out}/formal"
      ],
      "parser": "formal",
      "timeout": 7200
    },
    {
      "id": "check_cli",
      "command": [
        "cargo",
        "test",
        "--test",
        "check_cli",
        "--",
        "--nocapture"
      ],
      "parser": "rust",
      "timeout": 1800,
      "requires": [
        "clang++",
        "verilator",
        "z3"
      ]
    },
    {
      "id": "arithmetic_solver_conformance",
      "command": [
        "cargo",
        "test",
        "--test",
        "arithmetic_solver_conformance",
        "--",
        "--nocapture"
      ],
      "parser": "rust",
      "timeout": 1800,
      "requires": [
        "clang++",
        "verilator",
        "z3"
      ]
    },
    {
