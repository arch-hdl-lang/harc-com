  "formal": {
    "cbmc": [
      "u128-mask",
      "u128-compare",
      "u128-shift",
      "u128-divzero",
      "u128-divrem-1",
      "u128-divrem-2",
      "u128-divrem-3",
      "u128-divrem-4",
      "u128-divrem-5",
      "u128-divrem-6",
      "u128-divrem-7",
      "u128-divrem-8",
      "u128-sext",
      "u128-shift-count",
      "wide-arith-1",
      "wide-extend-1",
      "wide-arith-2",
      "wide-extend-2",
      "wide-arith-4",
      "wide-extend-4",
      "wide-arith-5",
      "wide-extend-5",
      "wide-arith-8",
      "wide-extend-8",
      "wide-arith-32",
      "wide-extend-32",
      "rng-full",
      "rng-half",
      "rng-small",
      "rng-degenerate"
    ],
    "kani": [
      "const_add_sub",
      "const_mul",
      "const_wrap",
      "const_compare",
      "const_shift",
      "const_bit_logic",
      "const_bitwise_laws",
      "const_wrapping_roundtrip",
      "const_div_rem",
      "const_errors",
      "solver_promotion",
      "solver_unknown_widths"
    ]
  },
  "missing_families": [
    "Complete parser grammar and diagnostic equivalence",
    "Whole expression lowering, SMT sort construction and solver emission",
    "32/64/128-bit full signed division and remainder equivalence",
    "Wide multiply/divide and arbitrary storage capacities",
    "Coroutine scheduling, fairness and unbounded temporal behavior",
    "Unbounded component graphs and arbitrary aggregate nesting",
    "Complete coverage cross-bin semantics",
    "Complete RAL bus/protocol and external DUT behavior"
  ],
  "stop_gate": {
    "minimum_mutation_areas": 8,
    "minimum_mutation_percent": 90,
    "minimum_distinct_fuzz_cases": 10000,
    "minimum_fuzz_seeds": 3,
    "flat_fuzz_campaigns": 3,
    "clean_hunts": 3,
    "hunt_scopes": 10,
    "minimum_mutation_count": 30
  }
}
